---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { LEAD_LIMITS } from '../lib/lead-validation.js';

---
<section id="lead" class="py-14 md:py-20 scroll-mt-20">
  <div class="container-site">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">Запишіться на безкоштовний аудит ідеї</h2>
      <p class="mt-4 text-muted text-lg">
        Залиште ім’я та телефон — зв’яжемося з вами й узгодимо безкоштовний аудит до 20 хвилин. Якщо зручніше, оберіть дату й час. Або напишіть напряму:
      </p>

      {/* Прямі кнопки-месенджери */}
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl">
        <a href={site.telegram} target="_blank" rel="noopener" class="btn btn-ghost !min-h-[52px]" data-analytics="click_telegram">
          <Icon name="send" size={18} /> Telegram
        </a>
        <a href={site.viber} class="btn btn-ghost !min-h-[52px]" data-analytics="click_viber">
          <Icon name="message-circle" size={18} /> Viber
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost !min-h-[52px]" data-analytics="click_whatsapp">
          <Icon name="message-circle" size={18} /> WhatsApp
        </a>
        <a href={`tel:${site.phone}`} class="btn btn-ghost !min-h-[52px]" data-analytics="click_phone">
          <Icon name="phone" size={18} /> Дзвінок
        </a>
      </div>
    </div>

    <div class="reveal mt-8 rounded-card-lg bg-surface border border-border p-5 md:p-8">
      <div class="flex flex-wrap gap-3 mb-6" role="group" aria-label="Як зв’язатися з вами">
        <button type="button" class="btn btn-primary" data-lf-mode="callback" aria-pressed="true">Зв’яжіться зі мною</button>
        <button type="button" class="btn btn-ghost" data-lf-mode="scheduled" aria-pressed="false">Обрати дату й час</button>
      </div>
      <div id="lf-form-wrap" class="grid gap-8 lg:gap-12">
        {/* Календар */}
        <div data-lf-calendar hidden>
          <div class="flex items-center justify-between mb-4">
            <button type="button" data-lf-prev aria-label="Попередній місяць"
              class="inline-grid place-items-center w-11 h-11 rounded-xl border border-border text-muted hover:text-ink hover:border-accent transition-colors disabled:opacity-30 disabled:pointer-events-none">
              <Icon name="chevron-down" size={18} class="rotate-90" />
            </button>
            <div data-lf-month class="font-display font-semibold text-lg capitalize">—</div>
            <button type="button" data-lf-next aria-label="Наступний місяць"
              class="inline-grid place-items-center w-11 h-11 rounded-xl border border-border text-muted hover:text-ink hover:border-accent transition-colors">
              <Icon name="chevron-down" size={18} class="-rotate-90" />
            </button>
          </div>
          <div class="grid grid-cols-7 gap-1.5 text-center text-xs text-muted mb-2">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Нд</span>
          </div>
          <div data-lf-days class="grid grid-cols-7 gap-1"></div>
          <p class="mt-4 text-xs text-muted flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-accent"></span> обрана дата · неділя — вихідний
          </p>
        </div>

        {/* Час + контакти */}
        <div>
          <div data-lf-time-empty class="text-muted text-sm py-4" hidden>
            Оберіть день у календарі, потім бажаний час.
          </div>

          <div data-lf-time-wrap hidden>
            <div class="text-sm font-medium mb-3">
              Бажаний час на <span data-lf-picked-date class="text-accent">—</span>
            </div>
            <p class="text-sm text-muted mb-3">За київським часом. Це запит на консультацію, не підтверджене бронювання.</p>
            <div data-lf-slots class="grid grid-cols-3 sm:grid-cols-4 gap-2 mb-6"></div>
          </div>

          <form id="lead-form" method="post" novalidate>
            {/* Honeypot (приховане поле від спаму) */}
            <div class="hidden" aria-hidden="true">
              <label>Не заповнюйте це поле<input type="text" name="hp_gp_2026" tabindex="-1" autocomplete="off" /></label>
            </div>
            {/* Прихований payload квізу (заповнюється JS) */}
            <input type="hidden" name="quiz" id="lead-quiz" value="" />
            <input type="hidden" name="source" value="audit" />
            <input type="hidden" name="requestId" data-request-id />
            <input type="hidden" name="date" data-lf-date value="" />
            <input type="hidden" name="time" data-lf-time value="" />

            <div class="space-y-4">
              <div>
                <label for="lf-name" class="block text-sm font-medium mb-1.5">Ім’я <span class="text-accent">*</span></label>
                <input
                  id="lf-name" name="name" type="text" required autocomplete="name" maxlength={LEAD_LIMITS.name}
                  class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted focus:border-accent outline-none"
                  placeholder="Ваше ім’я"
                />
              </div>

              <div>
                <label for="lf-phone" class="block text-sm font-medium mb-1.5">Телефон <span class="text-accent">*</span></label>
                <input
                  id="lf-phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel"
                  class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted focus:border-accent outline-none"
                  placeholder="+380 __ ___ __ __" value="+380"
                  aria-describedby="lf-phone-error"
                />
                <p id="lf-phone-error" class="mt-1 text-xs hidden text-accent-hover" role="alert" data-phone-error>Введіть коректний номер у форматі +380XXXXXXXXX</p>
              </div>

              <fieldset>
                <legend class="block text-sm font-medium mb-2">Зручний месенджер</legend>
                <div class="flex flex-wrap gap-2">
                  {['Telegram', 'Viber', 'Дзвінок'].map((m, i) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="messenger" value={m} class="peer sr-only" checked={i === 0} />
                      <span class="inline-flex items-center rounded-xl border border-border px-4 py-2.5 text-sm peer-checked:border-accent peer-checked:text-accent peer-checked:bg-accent/10 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent transition-colors">{m}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="lf-idea" class="block text-sm font-medium mb-1.5">Коротко про ідею <span class="text-muted font-normal">(необов’язково)</span></label>
                <textarea
                  id="lf-idea" name="idea" rows="3" maxlength={LEAD_LIMITS.idea} aria-describedby="lf-idea-count"
                  class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted focus:border-accent outline-none resize-y"
                  placeholder="Наприклад: майстерня з ремонту техніки, 1 робоче місце"
                ></textarea>
                <p id="lf-idea-count" class="mt-1 text-xs text-muted text-right" data-idea-count>0 / {LEAD_LIMITS.idea}</p>
              </div>

              <label class="flex items-start gap-3 text-sm text-muted">
                <input type="checkbox" name="consent" required class="mt-1 w-4 h-4 accent-accent shrink-0" />
                <span>Погоджуюсь на обробку персональних даних згідно з <a href="/privacy" class="text-accent underline">політикою конфіденційності</a> <span class="text-accent">*</span></span>
              </label>

              <button type="submit" class="btn btn-primary w-full" data-submit>
                Зв’яжіться зі мною
              </button>
              <p class="text-sm text-accent-hover text-center hidden" role="alert" data-lead-error data-tg={site.telegram}></p>
            </div>
          </form>
        </div>
      </div>

      {/* Екран подяки */}
      <div id="lead-success" class="hidden text-center py-10">
        <span class="inline-grid place-items-center w-16 h-16 rounded-full bg-success/15 text-success mx-auto">
          <Icon name="check-circle" size={32} />
        </span>
        <h3 class="mt-5 text-2xl font-display font-semibold">Заявку надіслано ✓</h3>
        <p class="mt-2 text-muted" data-lf-summary>Зв’яжемося з вами у Telegram або телефоном, щоб узгодити безкоштовний аудит.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';
  import { kyivClock } from '../lib/booking-clock.js';
  import { LEAD_LIMITS, LEAD_FIELD_LABELS } from '../lib/lead-validation.js';

  const root = document.getElementById('lead');
  if (root) {
    const MONTHS = ['Січень','Лютий','Березень','Квітень','Травень','Червень','Липень','Серпень','Вересень','Жовтень','Листопад','Грудень'];
    const MONTHS_GEN = ['січня','лютого','березня','квітня','травня','червня','липня','серпня','вересня','жовтня','листопада','грудня'];
    const WEEKDAYS = ['неділя','понеділок','вівторок','середа','четвер','пʼятниця','субота'];
    const SLOTS = ['10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00'];

    const monthLabel = root.querySelector('[data-lf-month]') as HTMLElement;
    const daysGrid = root.querySelector('[data-lf-days]') as HTMLElement;
    const prevBtn = root.querySelector('[data-lf-prev]') as HTMLButtonElement;
    const nextBtn = root.querySelector('[data-lf-next]') as HTMLButtonElement;
    const timeEmpty = root.querySelector('[data-lf-time-empty]') as HTMLElement;
    const timeWrap = root.querySelector('[data-lf-time-wrap]') as HTMLElement;
    const slotsGrid = root.querySelector('[data-lf-slots]') as HTMLElement;
    const pickedDateEl = root.querySelector('[data-lf-picked-date]') as HTMLElement;
    const form = root.querySelector('#lead-form') as HTMLFormElement;
    const dateInput = root.querySelector('[data-lf-date]') as HTMLInputElement;
    const timeInput = root.querySelector('[data-lf-time]') as HTMLInputElement;
    const phoneInput = root.querySelector('#lf-phone') as HTMLInputElement;
    const phoneError = root.querySelector('[data-phone-error]') as HTMLElement;
    const submitBtn = root.querySelector('[data-submit]') as HTMLButtonElement;
    const success = root.querySelector('#lead-success') as HTMLElement;
    const formWrap = root.querySelector('#lf-form-wrap') as HTMLElement;
    const summaryEl = root.querySelector('[data-lf-summary]') as HTMLElement;
    const leadError = root.querySelector('[data-lead-error]') as HTMLElement;
    const showError = (msg: string) => { if (leadError) { leadError.textContent = msg; leadError.classList.remove('hidden'); } };
    const hideError = () => leadError?.classList.add('hidden');

    // Сервер відхилив значення (надто довге/некоректне): нічого не обрізаємо й не
    // скидаємо — поля лишаються заповненими, людина виправляє й надсилає ще раз.
    const ideaInput = root.querySelector('#lf-idea') as HTMLTextAreaElement | null;
    const ideaCount = root.querySelector('[data-idea-count]') as HTMLElement | null;
    const updateIdeaCount = () => {
      if (ideaInput && ideaCount) ideaCount.textContent = `${ideaInput.value.length} / ${LEAD_LIMITS.idea}`; // одиниці UTF-16, як у maxlength
    };
    ideaInput?.addEventListener('input', updateIdeaCount);
    updateIdeaCount();

    type Rejection = { error?: string; scope?: string; field?: string; max?: number; message?: string };
    const rejectionMessage = (r: Rejection): string => {
      const label = r.field ? (LEAD_FIELD_LABELS as Record<string, string>)[r.field] : undefined;
      if (r.error === 'too_long' && r.scope !== 'message' && label && typeof r.max === 'number') {
        return `Поле «${label}» задовге: максимум ${r.max} символів. Скоротіть текст і надішліть ще раз — введене збережено.`;
      }
      if (typeof r.message === 'string' && r.message.length <= 300) return `${r.message} Введене збережено.`;
      return 'Перевірте введені дані й надішліть ще раз — введене збережено.';
    };

    const today = kyivClock(); today.setUTCHours(0, 0, 0, 0);
    let viewYear = today.getUTCFullYear();
    let viewMonth = today.getUTCMonth();
    let selected: Date | null = null;
    let scheduled = false;
    const calendar = root.querySelector('[data-lf-calendar]') as HTMLElement;
    const modeButtons = root.querySelectorAll<HTMLButtonElement>('[data-lf-mode]');
    const submitLabel = () => scheduled ? 'Надіслати заявку' : 'Зв’яжіться зі мною';
    modeButtons.forEach((button) => button.addEventListener('click', () => {
      if (submitBtn.disabled) return;
      scheduled = button.dataset.lfMode === 'scheduled';
      calendar.hidden = !scheduled;
      formWrap.classList.toggle('lg:grid-cols-2', scheduled);
      selected = null;
      dateInput.value = '';
      timeInput.value = '';
      const requestId = form.querySelector<HTMLInputElement>('[data-request-id]');
      if (requestId) requestId.value = '';
      timeWrap.hidden = true;
      timeEmpty.hidden = !scheduled;
      form.hidden = scheduled;
      submitBtn.textContent = submitLabel();
      modeButtons.forEach((b) => {
        const active = b === button;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('btn-primary', active);
        b.classList.toggle('btn-ghost', !active);
      });
      hideError();
      renderCalendar();
    }));

    const fmtLong = (d: Date) => `${WEEKDAYS[d.getUTCDay()]}, ${d.getUTCDate()} ${MONTHS_GEN[d.getUTCMonth()]}`;

    function renderCalendar() {
      monthLabel.textContent = `${MONTHS[viewMonth]} ${viewYear}`;
      prevBtn.disabled = (viewYear === today.getUTCFullYear() && viewMonth === today.getUTCMonth());

      daysGrid.innerHTML = '';
      const first = new Date(Date.UTC(viewYear, viewMonth, 1));
      const offset = (first.getUTCDay() + 6) % 7;
      const daysInMonth = new Date(Date.UTC(viewYear, viewMonth + 1, 0)).getUTCDate();

      for (let i = 0; i < offset; i++) {
        daysGrid.appendChild(document.createElement('span'));
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const d = new Date(Date.UTC(viewYear, viewMonth, day));
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(day);
        btn.setAttribute('aria-label', fmtLong(d));
        const isPast = d < today;
        const isSunday = d.getUTCDay() === 0;
        const disabled = isPast || isSunday;
        const isSelected = !!selected && d.getTime() === selected.getTime();
        btn.setAttribute('aria-pressed', String(isSelected));
        btn.className = 'aspect-square min-h-[44px] rounded-xl text-sm font-medium transition-colors ' +
          (disabled
            ? 'text-muted/30 pointer-events-none'
            : 'border border-border hover:border-accent hover:text-accent');
        if (disabled) btn.disabled = true;
        if (isSelected) {
          btn.className = 'aspect-square min-h-[44px] rounded-xl text-sm font-semibold bg-accent text-accent-ink';
        }
        btn.addEventListener('click', () => pickDate(d));
        daysGrid.appendChild(btn);
      }
    }

    function pickDate(d: Date) {
      selected = d;
      dateInput.value = `${String(d.getUTCDate()).padStart(2,'0')}.${String(d.getUTCMonth()+1).padStart(2,'0')}.${d.getUTCFullYear()} (${WEEKDAYS[d.getUTCDay()]})`;
      timeInput.value = '';
      const requestId = form.querySelector<HTMLInputElement>('[data-request-id]');
      if (requestId) requestId.value = '';
      renderCalendar();
      pickedDateEl.textContent = fmtLong(d);
      slotsGrid.innerHTML = '';
      const isToday = d.getTime() === today.getTime();
      const now = kyivClock();
      const availableSlots = isToday
        ? SLOTS.filter((t) => {
            const [h, m] = t.split(':').map(Number);
            return h > now.getUTCHours() || (h === now.getUTCHours() && m > now.getUTCMinutes());
          })
        : SLOTS;
      availableSlots.forEach((t) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = t;
        b.setAttribute('aria-pressed', 'false');
        b.className = 'rounded-xl border border-border px-2 py-2.5 text-sm hover:border-accent hover:text-accent transition-colors';
        b.addEventListener('click', () => pickTime(t, b));
        slotsGrid.appendChild(b);
      });
      if (!availableSlots.length) {
        slotsGrid.innerHTML = '<p class="text-sm text-muted col-span-full">На сьогодні час для звернення вже минув — оберіть інший день.</p>';
      }
      timeEmpty.setAttribute('hidden', '');
      timeWrap.removeAttribute('hidden');
      form.setAttribute('hidden', '');
    }

    function pickTime(t: string, el: HTMLButtonElement) {
      timeInput.value = t;
      const requestId = form.querySelector<HTMLInputElement>('[data-request-id]');
      if (requestId) requestId.value = '';
      slotsGrid.querySelectorAll('button').forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.className = 'rounded-xl border border-border px-2 py-2.5 text-sm hover:border-accent hover:text-accent transition-colors';
      });
      el.setAttribute('aria-pressed', 'true');
      el.className = 'rounded-xl border border-accent bg-accent/10 text-accent px-2 py-2.5 text-sm font-semibold';
      form.removeAttribute('hidden');
    }

    prevBtn.addEventListener('click', () => {
      viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      renderCalendar();
    });

    // Маска +380 — залишаємо тільки цифри, максимум 12 (380 + 9).
    // Знімаємо префікс 380 (якщо є) і національний нуль (050 → 50) ПЕРЕД тим,
    // як повертати його назад — інакше введення номера з нулем після вже
    // заповненого поля (+380 + "0501234567") даватиме биту склейку "3800501234567".
    function formatPhone(v: string): string {
      let digits = v.replace(/\D/g, '');
      if (digits.startsWith('380')) digits = digits.slice(3);
      digits = digits.replace(/^0+/, '');
      digits = '380' + digits;
      return '+' + digits.slice(0, 12);
    }
    phoneInput?.addEventListener('input', () => {
      const pos = phoneInput.selectionStart;
      phoneInput.value = formatPhone(phoneInput.value);
      if (pos) phoneInput.setSelectionRange(phoneInput.value.length, phoneInput.value.length);
    });

    function validPhone(v: string): boolean {
      return /^\+380\d{9}$/.test(v);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;

      const hp = (form.elements.namedItem('hp_gp_2026') as HTMLInputElement)?.value;
      if (hp) return; // бот

      hideError();

      if (scheduled && (!dateInput.value || !timeInput.value)) {
        showError('Оберіть дату й час у календарі вище.');
        return;
      }

      const name = (form.elements.namedItem('name') as HTMLInputElement)?.value.trim();
      if (!name) {
        showError('Вкажіть, будь ласка, ваше імʼя.');
        (form.elements.namedItem('name') as HTMLInputElement)?.focus();
        return;
      }

      const phone = phoneInput?.value ?? '';
      if (!validPhone(phone)) {
        phoneError?.classList.remove('hidden');
        phoneInput?.setAttribute('aria-invalid', 'true');
        phoneInput?.focus();
        return;
      }
      phoneError?.classList.add('hidden');
      phoneInput?.removeAttribute('aria-invalid');

      const consent = (form.elements.namedItem('consent') as HTMLInputElement)?.checked;
      if (!consent) {
        showError('Потрібна згода на обробку персональних даних.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Надсилаємо…';
      }

      const requestId = form.querySelector<HTMLInputElement>('[data-request-id]')!;
      if (!requestId.value) requestId.value = crypto.randomUUID();
      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        let result: (Rejection & { ok?: boolean; saved?: boolean }) | null = null;
        try { result = await res.json(); } catch { /* відповідь не JSON — розбереться перевірка нижче */ }
        if (res.status === 422 && result?.ok === false) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = submitLabel();
          }
          showError(rejectionMessage(result));
          const target = result.field === 'idea' ? ideaInput : result.field === 'phone' ? phoneInput : (form.elements.namedItem('name') as HTMLInputElement | null);
          target?.focus();
          return; // подію submit_form не відправляємо: заявку не прийнято
        }
        if (result?.saved && !result.ok) {
          showError('Заявку збережено, але доставку не підтверджено. Зв’яжіться з нами у Telegram або телефоном, щоб узгодити звернення.');
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = submitLabel(); }
          return;
        }
        if (!res.ok) throw new Error('bad response');
        if (result?.ok !== true) throw new Error('delivery not confirmed');
        if (summaryEl) summaryEl.textContent = scheduled && selected
          ? `Бажаний час: ${fmtLong(selected)}, ${timeInput.value}. Зв’яжемося з вами для підтвердження.`
          : 'Зв’яжемося з вами у Telegram або телефоном, щоб узгодити безкоштовний аудит.';
        modeButtons.forEach((b) => b.hidden = true);
        formWrap.classList.add('hidden');
        success?.classList.remove('hidden');
        trackEvent('submit_form', { form_type: 'audit' });
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel();
        }
        const tg = leadError?.dataset.tg || '';
        if (leadError) {
          leadError.innerHTML = `Не вдалося надіслати автоматично. Напишіть нам у <a href="${tg}" target="_blank" rel="noopener" class="underline font-semibold">Telegram</a> або зателефонуйте.`;
          leadError.classList.remove('hidden');
        }
      }
    });

    form.addEventListener('input', (event) => {
      if ((event.target as HTMLInputElement).name === 'consent' && leadError?.textContent?.startsWith('Потрібна згода')) leadError?.classList.add('hidden');
      const requestId = form.querySelector<HTMLInputElement>('[data-request-id]');
      if (requestId) requestId.value = '';
    });
    renderCalendar();
  }
</script>


---
import Icon from './Icon.astro';

// Модель постанови КМУ № 616, чинна з 1 вересня 2026: два напрями плюс
// надбавки, що підсумовуються, — замість окремих лімітів за категоріями.
const rows = [
  { label: 'Старт власної справи', sum: '100 000 – 300 000 ₴', kh: 'робочі місця для базової суми не обов’язкові' },
  { label: 'Масштабування діючої', sum: '500 000 – 1 500 000 ₴', kh: 'обов’язкове 1 нове робоче місце' },
  { label: 'Стеля на старті', sum: 'до 500 000 ₴', kh: 'базова сума плюс надбавки' },
  { label: 'Стеля на масштабуванні', sum: 'до 2 500 000 ₴', kh: 'базова сума плюс надбавки' },
  { label: 'Молодь 18–25', sum: '+5%', kh: 'надбавка до суми' },
  { label: 'Ветеранське підприємництво', sum: '+20%', kh: 'також ПДВ, патент, ВПО або 2 робочі місця' },
  { label: 'Прифронтові області', sum: '+30%', kh: 'або відновлення зруйнованих потужностей' },
  { label: 'Пріоритетний сектор', sum: '+50%', kh: 'за КВЕД: агро, ІТ, переробка, оборонка та інші' },
  { label: 'Повторний грант', sum: 'один раз', kh: 'після виконання умов попереднього' },
];
---
<section class="py-14 md:py-20 border-t border-border/70 bg-surface/30">
  <div class="container-site">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">Скільки можна отримати у 2026 році</h2>
    </div>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {rows.map((r) => (
        <div class="reveal rounded-card bg-surface border border-border p-5 flex flex-col">
          <div class="flex items-center gap-2.5">
            <Icon name="wallet" size={20} class="text-accent" />
            <span class="font-medium">{r.label}</span>
          </div>
          <div class="mt-3 font-display font-extrabold text-xl text-accent">{r.sum}</div>
          {r.kh && <div class="mt-1 text-sm text-success">{r.kh}</div>}
        </div>
      ))}
    </div>

    <p class="reveal mt-6 text-sm text-muted max-w-3xl">
      Умови за постановою КМУ від 15 травня 2026 р. № 616, чинною з 1 вересня 2026 року. Надбавки підсумовуються, але сума не може перевищити стелю напряму. Перевіряємо чинну на дату подання редакцію порядку перед кожною заявкою.
      <a href="/umovy-prohramy" class="text-accent hover:underline">Повні умови з посиланнями на офіційні джерела →</a>
    </p>

    <div class="reveal mt-8 rounded-card bg-surface border border-border p-6 md:p-7 max-w-3xl">
      <h3 class="font-display font-semibold text-lg">Допомагаємо із суміжними програмами</h3>
      <p class="mt-2 text-muted text-[0.95rem]">
        Якщо ваш проєкт переріс «Власну справу» — підкажемо правильні «двері»: гранти для переробних підприємств (до 8 млн ₴ на обладнання, серед напрямів — і виробництво БпЛА), Український ветеранський фонд «Варто», напрями для садів і теплиць. На аудиті орієнтуємо, під яку програму ваша ідея підходить найкраще.
      </p>
    </div>
  </div>
</section>

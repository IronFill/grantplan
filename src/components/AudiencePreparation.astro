---
interface Props { slug: string }
const { slug } = Astro.props;
const guides: Record<string, { title: string; items: string[]; example: string; exampleLabel: string }> = {
  agrobiznes: {
    title: 'Що підготувати для обговорення агропроєкту',
    items: [
      'Опишіть продукцію або послугу, площу та приміщення, які вже є або плануєте використовувати.',
      'Складіть попередній перелік техніки й обладнання; додайте посилання на ціни постачальників, якщо вони вже є.',
      'Продумайте сезонність: коли виникають витрати, коли надходить виручка і кому плануєте продавати продукцію.',
    ],
    example: '/case-ripak', exampleLabel: 'Приклад розрахунків для агропроєкту',
  },
  veteranam: {
    title: 'З чого почати підготовку ветеранської заявки',
    items: [
      'Розкажіть, хто планує подати заявку та чи вже зареєстровано бізнес. Особисті документи на першому кроці не потрібні.',
      'Коротко опишіть справу, попередній бюджет і те, що вже маєте: досвід, обладнання, приміщення або клієнтів.',
      'Позначте, чи це старт нової справи або розвиток діючої, і які питання щодо статусу та програми потрібно уточнити.',
    ],
    example: '/spivbesida', exampleLabel: 'Як підготуватися до співбесіди',
  },
  molod: {
    title: 'Що продумати перед першим бізнес-планом',
    items: [
      'Поясніть простими словами, що продаватимете, кому це потрібно і чому клієнт обере вас.',
      'Запишіть стартові покупки та щомісячні витрати: матеріали, оренду, рекламу й інші потреби саме вашої справи.',
      'Прикиньте кількість замовлень і ціну. Якщо даних поки немає — так і скажіть: припущення потрібно перевірити.',
    ],
    example: '/case-sto', exampleLabel: 'Приклад плану невеликої майстерні',
  },
  povtorny: {
    title: 'Що звірити перед обговоренням повторної заявки',
    items: [
      'Підготуйте короткий опис першого проєкту та його стану: що реалізовано і які зобов’язання ще залишаються.',
      'Окремо сформулюйте нову мету та витрати. Позначте, що вже придбано або профінансовано раніше.',
      'Запишіть питання щодо попереднього договору та звітності. Право на повторну участь перевіряємо за чинними умовами, а не припускаємо автоматично.',
    ],
    example: '/pislya-hrantu', exampleLabel: 'Зобов’язання після отримання гранту',
  },
};
const questions: Record<string, { question: string; answer: string }[]> = {
  "agrobiznes": [
    {
      "question": "Як показати сезонність у бізнес-плані?",
      "answer": "Розділіть витрати та надходження за місяцями: закупівля матеріалів, виробничий цикл, зберігання та продаж. Позначте періоди, коли витрати вже є, а виручки ще немає. Під час розмови звіримо, як це відображено у фінансовій моделі."
    },
    {
      "question": "Що потрібно знати про обладнання?",
      "answer": "Запишіть модель, продуктивність, комплектацію, ціну, доставку та потреби в електроенергії чи приміщенні. Поясніть, який обсяг продукції зможете продати, а не лише виготовити. Чи допустима конкретна закупівля за обраною програмою, перевіряємо окремо."
    }
  ],
  "veteranam": [
    {
      "question": "З чого почати, якщо ідея є, а бізнес ще не зареєстрований?",
      "answer": "Опишіть досвід, послугу або продукцію, майбутніх клієнтів і стартові покупки. Для першої розмови не потрібно збирати пакет особистих документів. Вибір програми та вимоги до заявника уточнюємо окремо за актуальними правилами."
    },
    {
      "question": "Що робити, якщо заявником буде інша людина з родини?",
      "answer": "Одразу скажіть, хто планує подавати заявку і хто фактично працюватиме в бізнесі. Не варто автоматично припускати, що статус одного члена родини поширює умови на іншого. Ролі в проєкті та право участі звіряємо до підготовки документів."
    }
  ],
  "molod": [
    {
      "question": "Як порахувати продажі для першої справи?",
      "answer": "Почніть із ціни одного замовлення, кількості клієнтів, яких реально можете обслужити, та способу їх залучення. Врахуйте час на запуск і повільні місяці. Якщо це припущення, позначте його: воно потребує перевірки, а не красивої цифри в таблиці."
    },
    {
      "question": "Чи потрібно одразу купувати обладнання?",
      "answer": "Для розмови достатньо списку потрібних позицій і пропозицій постачальників. Купівлю не потрібно робити лише заради заповнення плану. Черговість витрат та допустимість фінансування з конкретної програми перевіряємо перед рішеннями."
    }
  ],
  "povtorny": [
    {
      "question": "Повтор після відмови та наступний грант — це одне й те саме?",
      "answer": "Ні. Після відмови розбираємо рішення і матеріали попередньої заявки. Після отриманого фінансування потрібно врахувати попередній договір, виконання зобов’язань і вже профінансовані витрати. На початку розмови уточнюємо саме вашу ситуацію."
    },
    {
      "question": "Як відокремити новий проєкт від попереднього?",
      "answer": "Складіть два переліки: що вже зроблено або придбано та що плануєте тепер. Поясніть нову мету і джерела її фінансування. Умови наступної участі перевіряємо окремо; наявність попереднього гранту сама по собі не підтверджує можливість нового."
    }
  ]
};
const guide = guides[slug];
---
{guide && (
  <section class="py-14 md:py-20 border-t border-border/70" aria-labelledby="audience-preparation-title">
    <div class="container-site max-w-3xl">
      <h2 id="audience-preparation-title" class="text-2xl sm:text-3xl">{guide.title}</h2>
      <p class="mt-4 text-muted">Це підготовка до першої розмови, а не офіційний перелік документів для подання. Достатньо того, що вже знаєте; відсутні дані уточнимо разом.</p>
      <ol class="mt-6 list-decimal pl-6 space-y-4 text-muted">
        {guide.items.map((item) => <li class="pl-2">{item}</li>)}
      </ol>
      <p class="mt-6 text-sm text-muted">Не надсилайте через форму паспорт, податковий номер чи інші особисті документи — для запису потрібні лише ім’я та контакт.</p>
      <div class="mt-8 space-y-5">
        <h3 class="text-xl">Питання перед підготовкою плану</h3>
        {questions[slug]?.map(item => <article class="rounded-card border border-border bg-surface p-5"><h4 class="text-lg font-semibold">{item.question}</h4><p class="mt-3 text-muted">{item.answer}</p></article>)}
      </div>
      <nav aria-label="Матеріали для підготовки заявки" class="mt-6 flex flex-col items-start gap-3">
        <a href="/poslugy" class="text-accent underline underline-offset-4 py-2">Підготовка бізнес-плану: склад послуг і ціни</a>
        <a href={guide.example} class="text-accent underline underline-offset-4 py-2">{guide.exampleLabel}</a>
        <a href="/blog/dokumenty-dlya-konsultatsii/" class="text-accent underline underline-offset-4 py-2">Що підготувати до першої консультації</a>
        <a href="/umovy-prohramy" class="text-accent underline underline-offset-4 py-2">Чинні умови програми та офіційні джерела</a>
      </nav>
      <a href="#lead" class="btn btn-primary mt-6">Записатися на безкоштовний аудит</a>
    </div>
  </section>
)}

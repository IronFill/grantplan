---
interface Props { slug: string }
const { slug } = Astro.props;
const guides: Record<string, { title: string; items: string[]; example: string; exampleLabel: string }> = {
  agrobiznes: {
    title: 'Що підготувати для обговорення агропроєкту',
    items: [
      'Опишіть продукцію або послугу, площу та приміщення, які вже є або плануєте використовувати.',
      'Складіть попередній перелік техніки й обладнання; додайте посилання на ціни постачальників, якщо вони вже є.',
      'Продумайте сезонність: коли виникають витрати, коли надходить виручка і кому плануєте продавати продукцію.',
    ],
    example: '/case-ripak', exampleLabel: 'Приклад розрахунків для агропроєкту',
  },
  veteranam: {
    title: 'З чого почати підготовку ветеранської заявки',
    items: [
      'Розкажіть, хто планує подати заявку та чи вже зареєстровано бізнес. Особисті документи на першому кроці не потрібні.',
      'Коротко опишіть справу, попередній бюджет і те, що вже маєте: досвід, обладнання, приміщення або клієнтів.',
      'Позначте, чи це старт нової справи або розвиток діючої, і які питання щодо статусу та програми потрібно уточнити.',
    ],
    example: '/spivbesida', exampleLabel: 'Як підготуватися до співбесіди',
  },
  molod: {
    title: 'Що продумати перед першим бізнес-планом',
    items: [
      'Поясніть простими словами, що продаватимете, кому це потрібно і чому клієнт обере вас.',
      'Запишіть стартові покупки та щомісячні витрати: матеріали, оренду, рекламу й інші потреби саме вашої справи.',
      'Прикиньте кількість замовлень і ціну. Якщо даних поки немає — так і скажіть: припущення потрібно перевірити.',
    ],
    example: '/case-sto', exampleLabel: 'Приклад плану невеликої майстерні',
  },
  povtorny: {
    title: 'Що звірити перед обговоренням повторної заявки',
    items: [
      'Підготуйте короткий опис першого проєкту та його стану: що реалізовано і які зобов’язання ще залишаються.',
      'Окремо сформулюйте нову мету та витрати. Позначте, що вже придбано або профінансовано раніше.',
      'Запишіть питання щодо попереднього договору та звітності. Право на повторну участь перевіряємо за чинними умовами, а не припускаємо автоматично.',
    ],
    example: '/pislya-hrantu', exampleLabel: 'Зобов’язання після отримання гранту',
  },
};
const guide = guides[slug];
---
{guide && (
  <section class="py-14 md:py-20 border-t border-border/70" aria-labelledby="audience-preparation-title">
    <div class="container-site max-w-3xl">
      <h2 id="audience-preparation-title" class="text-2xl sm:text-3xl">{guide.title}</h2>
      <p class="mt-4 text-muted">Це підготовка до першої розмови, а не офіційний перелік документів для подання. Достатньо того, що вже знаєте; відсутні дані уточнимо разом.</p>
      <ol class="mt-6 list-decimal pl-6 space-y-4 text-muted">
        {guide.items.map((item) => <li class="pl-2">{item}</li>)}
      </ol>
      <p class="mt-6 text-sm text-muted">Не надсилайте через форму паспорт, податковий номер чи інші особисті документи — для запису потрібні лише ім’я та контакт.</p>
      <nav aria-label="Матеріали для підготовки заявки" class="mt-6 flex flex-col items-start gap-3">
        <a href="/poslugy" class="text-accent underline underline-offset-4 py-2">Підготовка бізнес-плану: склад послуг і ціни</a>
        <a href={guide.example} class="text-accent underline underline-offset-4 py-2">{guide.exampleLabel}</a>
        <a href="/umovy-prohramy" class="text-accent underline underline-offset-4 py-2">Чинні умови програми та офіційні джерела</a>
      </nav>
      <a href="#lead" class="btn btn-primary mt-6">Обговорити ідею на безкоштовному аудиті</a>
    </div>
  </section>
)}

---
import Icon from './Icon.astro';
import { tiers, rework } from '../data/pricing';

const plans = [
  {
    name: 'Аудит ідеї',
    price: 'Безкоштовно',
    priceNote: null,
    featured: false,
    features: [
      'Консультація до 20 хв',
      'Оцінка відповідності програмі',
      'Чесний вердикт і план дій',
    ],
    cta: 'Записатись',
    href: '/#lead',
    analytics: 'click_plan_audit',
  },
  {
    name: 'Бізнес-план',
    price: tiers.plan.label,
    priceNote: 'популярний вибір',
    featured: true,
    features: [
      'Повний план за формою Дії (XLS + Word)',
      'Кошторис з обґрунтуванням цін',
      'Фінмодель і податки',
      '2 раунди правок',
      `Строк ${tiers.plan.term}`,
    ],
    cta: 'Замовити план',
    href: '/#lead',
    analytics: 'click_plan_plan',
    termsHref: '/umovy-spivpratsi-biznes-plan',
    termsAnalytics: 'click_terms_plan',
  },
  {
    name: '«Під ключ»',
    price: tiers.turnkey.label,
    priceNote: null,
    featured: false,
    features: [
      'Все з тарифу «Бізнес-план»',
      'Презентація для співбесіди',
      'Супровід подання через Дію',
      'Репетиція співбесіди',
      'Підтримка до рішення',
      `Строк ${tiers.turnkey.term}`,
    ],
    cta: 'Обрати супровід',
    href: '/#lead',
    analytics: 'click_plan_turnkey',
    termsHref: '/umovy-spivpratsi-pid-kluch',
    termsAnalytics: 'click_terms_turnkey',
  },
];
---
<section id="pricing" class="py-14 md:py-20 scroll-mt-20" data-track-view="view_pricing">
  <div class="container-site">
    <div class="reveal max-w-2xl">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Скільки коштує</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Тарифи</h2>
      <p class="mt-3 text-muted text-lg">Прозоро й без прихованих доплат. Оплата частинами.</p>
    </div>

    <div class="mt-10 grid md:grid-cols-3 gap-5 items-stretch">
      {plans.map((p) => (
        <article
          class={`reveal card-hover relative flex flex-col rounded-card p-6 md:p-7 border ${
            p.featured
              ? 'bg-raised border-accent shadow-[0_0_0_1px_var(--color-accent)]'
              : 'bg-surface border-border'
          }`}
        >
          {p.featured && (
            <span class="absolute -top-3 left-6 inline-flex items-center gap-1.5 rounded-full bg-accent text-accent-ink px-3 py-1 text-xs font-semibold font-display">
              <Icon name="star" size={13} /> Найпопулярніший
            </span>
          )}
          <h3 class="text-xl font-display font-semibold">{p.name}</h3>
          <div class="mt-3 font-display font-extrabold text-2xl sm:text-[1.75rem] text-accent">{p.price}</div>

          <ul class="mt-6 space-y-3 flex-1">
            {p.features.map((f) => (
              <li class="flex items-start gap-2.5 text-[0.95rem]">
                <Icon name="check" size={18} class="text-success shrink-0 mt-0.5" />
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href={p.href}
            class={`btn mt-7 w-full ${p.featured ? 'btn-primary' : 'btn-ghost'}`}
            data-analytics={p.analytics}
          >{p.cta}</a>
          {p.termsHref ? (
            <a
              href={p.termsHref}
              class="mt-1 py-3 text-center text-sm text-muted hover:text-accent underline underline-offset-2"
              data-analytics={p.termsAnalytics}
            >
              Умови співпраці
            </a>
          ) : (
            <span class="mt-1 py-3 text-center text-sm invisible" aria-hidden="true">Умови співпраці</span>
          )}
        </article>
      ))}
    </div>

    <p class="reveal mt-6 text-sm text-muted text-center">
      Доопрацювання плану після відмови — {rework.label} · Оплата частинами: 50% аванс, 50% після готовності
    </p>
    <details class="reveal mt-4 max-w-3xl mx-auto rounded-card border border-border bg-surface/60">
      <summary class="cursor-pointer list-none px-5 py-3.5 text-sm text-muted hover:text-ink transition-colors flex items-center justify-between gap-3">
        <span>Умови оплати та повернення коштів</span>
        <Icon name="chevron-down" size={17} class="shrink-0 transition-transform" />
      </summary>
      <p class="px-5 pb-5 text-sm text-muted leading-relaxed">
        Якщо на безкоштовному аудиті ми доходимо висновку, що заявка не пройде, до оплати справа не доходить — тож ви завжди платите вже після чесної оцінки шансів, а не наосліп. Ціни наведено орієнтовно і не є публічною офертою: остаточна вартість залежить від обсягу робіт і погоджується в умовах співпраці до внесення авансу. Оскільки оплачується робота з підготовки документів, а не результат розгляду заявки, вартість послуг не залежить від рішення комісії та не підлягає поверненню в разі відмови у гранті.
      </p>
    </details>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  // Подія перегляду тарифів (один раз)
  const sec = document.querySelector<HTMLElement>('[data-track-view="view_pricing"]');
  if (sec && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            trackEvent('view_pricing');
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    io.observe(sec);
  }
</script>

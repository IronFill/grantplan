---
import Icon from './Icon.astro';
import { faq } from '../data/faq';
import { site } from '../data/site';
---
<!-- Заголовок винесено в липку ліву колонку, відповіді — у правій: інакше
     на широкому екрані рядок акордеону розтягувався б на всі 1200px заради
     одного короткого питання. Ширина секції при цьому та сама, що й у решти
     блоків головної (.container-site). -->
<section id="faq" class="py-14 md:py-20 scroll-mt-20">
  <div class="container-site grid lg:grid-cols-[0.8fr_1.6fr] gap-10 lg:gap-16 items-start">
    <div class="reveal lg:sticky lg:top-24">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Питання</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Часті питання</h2>
      <p class="mt-3 text-muted text-lg">Коротко й чесно про головне.</p>

      <div class="mt-8 rounded-card border border-border bg-surface p-6">
        <h3 class="font-display font-semibold text-lg">Не знайшли свого питання?</h3>
        <p class="mt-2 text-sm text-muted leading-relaxed">
          Загальна відповідь рідко підходить конкретній ситуації. На безкоштовному аудиті розберемо саме ваш випадок — і чесно скажемо, якщо шансів немає.
        </p>
        <a href="/#lead" class="btn btn-primary w-full mt-5">Записатися на безкоштовний аудит</a>
        <a
          href={site.telegram}
          target="_blank"
          rel="noopener"
          class="mt-3 py-1 flex items-center justify-center gap-2 text-sm text-muted hover:text-accent transition-colors"
          data-analytics="click_telegram"
        >
          <Icon name="send" size={16} /> Або напишіть у Telegram
        </a>
      </div>
    </div>

    <div class="space-y-3">
      {faq.map((item, i) => (
        <div class="reveal rounded-card bg-surface border border-border overflow-hidden">
          <h3>
            <button
              type="button"
              class="w-full flex items-center justify-between gap-4 text-left px-5 md:px-6 py-4 md:py-5"
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
              id={`faq-btn-${i}`}
              data-faq-btn
            >
              <span class="font-display font-semibold text-base md:text-lg">{item.q}</span>
              <Icon name="chevron-down" size={20} class="text-accent shrink-0 transition-transform duration-300" />
            </button>
          </h3>
          <div
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-btn-${i}`}
            class="grid grid-rows-[0fr] transition-all duration-300"
            data-faq-panel
          >
            <div class="overflow-hidden">
              <p class="px-5 md:px-6 pb-5 text-muted">{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq-btn]').forEach((btn) => {
    const panel = btn.parentElement?.parentElement?.querySelector<HTMLElement>('[data-faq-panel]');
    const icon = btn.querySelector('svg');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (panel) panel.style.gridTemplateRows = open ? '0fr' : '1fr';
      if (icon) icon.style.transform = open ? '' : 'rotate(180deg)';
    });
  });
</script>

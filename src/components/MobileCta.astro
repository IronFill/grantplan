---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  leadHref?: string;
}
const { leadHref = '/#lead' } = Astro.props;
---
{/* Нижня sticky-панель CTA (тільки мобільні, з урахуванням safe-area).
     Висота ≈ 74px (py-3 + кнопка 48px + рамка): від неї залежить відступ
     `bottom-[calc(4.75rem+…)]` у CookieConsent.astro — міняєте одне, перевірте й інше. */}
<div
  data-mobile-cta
  class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-border header-blur"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="flex items-center gap-3 px-4 py-3">
    <a href={leadHref} class="btn btn-primary flex-1 !min-h-[48px]" data-analytics="click_cta_sticky">
      Безкоштовний аудит
    </a>
    <a
      href={site.telegram}
      target="_blank" rel="noopener"
      class="inline-grid place-items-center w-12 h-12 rounded-xl border border-border text-ink shrink-0"
      aria-label="Написати в Telegram"
      data-analytics="click_telegram"
    >
      <Icon name="send" size={22} />
    </a>
  </div>
</div>

<style is:global>
  .cookie-banner-open [data-mobile-cta] { display: none; }
  [data-mobile-cta][data-in-view="true"] { display: none; }
</style>
<script>
  const panel = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const lead = document.getElementById('lead');
  if (panel && lead && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      panel.dataset.inView = String(entry.isIntersecting);
    }, { threshold: 0 }).observe(lead);
  }
</script>

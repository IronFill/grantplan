---
// Компактне представлення команди для головної: фото, ролі та одне речення
// замість двох повних карток із біографіями (ті лишились на /pro-nas).
// Обличчя виконавців мають бути видні одразу — це доводить, що працюють
// конкретні люди, а не «відділ», — але без 2.3 екрана тексту.
import Icon from './Icon.astro';
import { team } from '../data/team';
---
<section class="py-8 md:py-12 border-t border-border/70">
  <div class="container-site">
    <div class="reveal rounded-card-lg bg-surface border border-border p-6 md:p-8">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
        <div class="flex items-center gap-4 shrink-0">
          {team.map((p) => (
            <img
              src={p.photo}
              alt={p.alt}
              width="560" height="700" loading="lazy" decoding="async"
              class="aspect-[4/5] w-[88px] sm:w-[104px] shrink-0 object-cover rounded-card border border-image-outline"
            />
          ))}
        </div>

        <div class="flex-1">
          <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Двоє на кожному проєкті</span>
          <h2 class="mt-2 text-2xl sm:text-3xl">Хто робить вашу роботу</h2>
          <p class="mt-3 text-muted">
            Не відділ із безіменних виконавців: {team.map((p) => `${p.name} — ${p.role.toLowerCase()}`).join(', ')}.
            Юрист відповідає за відповідність вимогам, фінансистка — за цифри, які має витримати перевірка банківського оцінювача.
          </p>
          <a href="/pro-nas" class="mt-2 py-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:gap-2.5 transition-all" data-analytics="click_about_team">
            Досвід і підхід команди <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

---
// Для чисел, які має сенс "рахувати" (не діапазони на кшталт "2–3 дні"),
// задаємо prefix/to/suffix — JS анімує підрахунок при появі в в'юпорті.
// Значення value — фінальний текст, він же фолбек без JS.
const fmt = (n: number) => n.toLocaleString('uk-UA').replace(/,/g, ' ');

// Оцінка «~70% відмов» — з практики консультанта (див. коментар у
// src/data/rejections.ts), офіційної статистики ДСЗ із цього приводу
// не публікує. Тримайте напоготові підставу, якщо запитають.
const stats = [
  { prefix: 'до ', to: 500000, suffix: ' ₴', value: `до ${fmt(500000)} ₴`, label: 'на старт власної справи — з надбавками' },
  { value: 'До оплати', label: 'оцінка відповідності ідеї умовам програми' },
  { value: '2–3 дні', label: 'строк підготовки' },
  { value: 'Онлайн', label: 'працюємо з проєктами по всій Україні' },
];
---
<section class="py-12 md:py-16 border-y border-border/70 bg-surface/40">
  {/* На вузькому екрані — один стовпчик з розділювачами-лініями.
       Дві колонки тут ламали головне: «до 500 000 ₴» переносилось на три
       рядки з осиротілою гривнею, а вертикальні лінії між рядками сітки
       не збігались, бо підписи різної довжини. */}
  <div class="container-site grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-x-8 sm:gap-y-10">
    {stats.map((s, i) => (
      <div
        class={`reveal py-4 border-t border-border/60 first:border-t-0 first:pt-0 last:pb-0
                sm:py-0 sm:border-t-0 sm:pl-6 sm:border-l sm:border-border/60
                ${i % 2 === 0 ? 'sm:border-l-0 sm:pl-0' : ''}
                ${i > 0 ? 'lg:border-l lg:pl-6' : 'lg:border-l-0 lg:pl-0'}`}
      >
        <div
          class="font-display font-extrabold text-[2rem] sm:text-4xl lg:text-[2.5rem] leading-none text-accent tabular-nums whitespace-nowrap"
        >{s.value}</div>
        <div class="mt-2.5 text-sm text-muted leading-snug sm:max-w-[16rem]">{s.label}</div>
      </div>
    ))}
  </div>
  <div class="container-site mt-10">
    {/* Джерела даних потрібні, але вони — виноска, а не другий заголовок:
         тримаємо їх дрібнішими, щоб цифри лишались головним у блоці. */}
    <p class="text-xs text-muted/80 leading-relaxed max-w-3xl">
      Сума залежить від напряму та застосовних надбавок. Перевіряємо відповідність проєкту чинним умовам; отримання гранту не гарантуємо. <a href="/umovy-prohramy" class="text-accent underline py-2 inline-block">Умови та офіційні джерела</a>.
    </p>
  </div>
</section>

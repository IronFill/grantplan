---
// Плаваюча кнопка зв'язку («гармошка»): по натисканню над нею по черзі
// виїжджають месенджери, телефон і пошта. Підключена в Layout, тож є на
// всіх сторінках. На мобільних стоїть над нижньою панеллю MobileCta
// (висота ≈ 4.75rem, див. MobileCta.astro) і опускається, коли панель
// схована (форма заявки у вʼюпорті).
import Icon from './Icon.astro';
import { site } from '../data/site';

const items = [
  { label: 'Telegram', href: site.telegram, external: true, color: '#229ED9', icon: 'send', analytics: 'click_fab_telegram' },
  { label: 'Viber', href: site.viber, external: false, color: '#7360F2', icon: 'phone', analytics: 'click_fab_viber' },
  { label: 'WhatsApp', href: site.whatsapp, external: true, color: '#25D366', icon: 'message-circle', analytics: 'click_fab_whatsapp' },
  { label: site.email, href: `mailto:${site.email}`, external: false, color: '#64748B', icon: 'mail', analytics: 'click_fab_email' },
  { label: site.phoneDisplay, href: `tel:${site.phone}`, external: false, color: 'var(--color-accent)', icon: 'phone', analytics: 'click_fab_phone' },
] as const;
const count = items.length;
---
<div data-contact-fab class="contact-fab fixed right-4 lg:right-6 z-40" data-open="false">
  <ul id="contact-fab-menu" class="contact-fab__menu" aria-label="Способи зв'язку" inert>
    {items.map((it, i) => (
      <li style={`--i:${count - 1 - i}`}>
        <a
          href={it.href}
          {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}
          class="contact-fab__item"
          data-analytics={it.analytics}
        >
          <span class="contact-fab__icon" style={`background:${it.color}`} aria-hidden="true">
            {it.icon === 'mail' ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            ) : (
              <Icon name={it.icon} size={20} />
            )}
          </span>
          <span class="contact-fab__label">{it.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <button
    type="button"
    class="contact-fab__toggle"
    aria-expanded="false"
    aria-controls="contact-fab-menu"
    aria-label="Зв'язатися з нами"
    data-analytics="click_fab_open"
  >
    <span class="contact-fab__glyph contact-fab__glyph--open" aria-hidden="true"><Icon name="message-circle" size={26} /></span>
    <span class="contact-fab__glyph contact-fab__glyph--close" aria-hidden="true"><Icon name="x" size={26} /></span>
  </button>
</div>

<style is:global>
  .contact-fab {
    /* Над мобільною панеллю CTA; на десктопі та коли панелі немає — нижче. */
    bottom: calc(1rem + env(safe-area-inset-bottom));
  }
  @media (max-width: 1023.98px) {
    html:has([data-mobile-cta]:not([data-in-view='true'])) .contact-fab {
      bottom: calc(4.75rem + 0.75rem + env(safe-area-inset-bottom));
    }
  }
  @media (min-width: 1024px) {
    .contact-fab { bottom: 1.5rem; }
  }
  .cookie-banner-open .contact-fab { display: none; }

  .contact-fab__menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .contact-fab[data-open='true'] .contact-fab__menu { pointer-events: auto; }

  .contact-fab__menu li {
    opacity: 0;
    transform: translateY(14px) scale(0.92);
    transform-origin: right center;
    /* Закриття — у зворотному порядку, швидше за відкриття. */
    transition: opacity 0.16s ease, transform 0.16s ease;
    transition-delay: calc((4 - var(--i)) * 25ms);
  }
  .contact-fab[data-open='true'] .contact-fab__menu li {
    opacity: 1;
    transform: none;
    transition: opacity 0.24s ease, transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 45ms);
  }

  .contact-fab__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.4rem 1.25rem 0.4rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-raised);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.98rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.55);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .contact-fab__item:hover { border-color: var(--color-accent); }
  .contact-fab__item:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .contact-fab__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: #fff;
    flex-shrink: 0;
  }

  .contact-fab__toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    box-shadow: 0 14px 30px -10px rgba(238, 116, 9, 0.55), 0 4px 12px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, background-color 0.15s ease;
    cursor: pointer;
  }
  .contact-fab__toggle:hover { background: var(--color-accent-hover); transform: scale(1.05); }
  .contact-fab__toggle:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }

  .contact-fab__glyph {
    position: absolute;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease, transform 0.25s ease;
  }
  .contact-fab__glyph--close { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .contact-fab[data-open='true'] .contact-fab__glyph--open { opacity: 0; transform: rotate(90deg) scale(0.6); }
  .contact-fab[data-open='true'] .contact-fab__glyph--close { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .contact-fab__menu li,
    .contact-fab[data-open='true'] .contact-fab__menu li,
    .contact-fab__glyph,
    .contact-fab__toggle { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-contact-fab]');
  const toggle = root?.querySelector<HTMLButtonElement>('.contact-fab__toggle');
  const menu = root?.querySelector<HTMLElement>('.contact-fab__menu');

  if (root && toggle && menu) {
    const setOpen = (open: boolean) => {
      root.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Закрити' : "Зв'язатися з нами");
      if (open) menu.removeAttribute('inert');
      else menu.setAttribute('inert', '');
    };

    toggle.addEventListener('click', () => setOpen(root.dataset.open !== 'true'));

    // Клік повз меню закриває його; клік по посиланню — теж (після переходу).
    document.addEventListener('click', (e) => {
      if (root.dataset.open === 'true' && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

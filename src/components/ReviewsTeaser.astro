---
// Компактний тизер відгуків для головної: два перші відгуки короткою
// витримкою замість чотирьох повних (ті лишились на /vidhuky). Соціальний
// доказ має лишатись на шляху клієнта, але не забирати 3.8 екрана.
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';

const teaser = reviews.slice(0, 2);
const total = reviews.length;
---
<section class="py-14 md:py-20 border-t border-border/70">
  <div class="container-site">
    <div class="reveal flex flex-wrap items-end justify-between gap-4 max-w-4xl">
      <div>
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Досвід клієнтів</span>
        <h2 class="mt-2 text-3xl sm:text-4xl">Що кажуть клієнти</h2>
      </div>
      <a href="/vidhuky" class="text-sm font-medium text-accent hover:underline inline-flex items-center gap-1.5 py-3" data-analytics="click_reviews_all">
        Усі {total} відгуки <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="reveal mt-8 grid sm:grid-cols-2 gap-5">
      {teaser.map((r) => (
        <figure class="h-full rounded-card bg-surface border border-border p-6 flex flex-col">
          <Icon name="quote" size={24} class="text-accent/40" />
          <blockquote class="mt-3 text-muted text-[0.95rem] leading-relaxed flex-1">{r.short}</blockquote>
          <div class="mt-5 flex items-start gap-2 rounded-xl bg-success/10 border border-success/25 px-3 py-2 text-[0.8rem] font-medium text-success">
            <Icon name="check-circle" size={15} class="shrink-0 mt-px" />
            <span>{r.result}</span>
          </div>
          <figcaption class="mt-4 pt-4 border-t border-border/70 flex items-center justify-between gap-3">
            <div>
              <div class="font-semibold text-[0.95rem]">{r.name}</div>
              <div class="text-sm text-muted">{r.business}</div>
            </div>
            <div class="flex gap-0.5 text-accent shrink-0">
              {Array.from({ length: r.rating }).map(() => <Icon name="star" size={14} />)}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

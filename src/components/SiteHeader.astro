---
import Icon from './Icon.astro';
import { site, nav, navSecondary } from '../data/site';

// Поточний розділ підсвічуємо в мобільному меню, щоб було видно, де ти є.
// Порівнюємо лише шлях без якоря: пункти на кшталт /#pricing ведуть у секцію
// головної, і підсвічувати їх як «сторінку» було б неправдою.
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href.replace(/\/$/, '') === here;
---
<header id="site-header" class="fixed top-0 inset-x-0 z-[60] transition-colors" data-header>
  <div class="container-site flex items-center justify-between h-16 md:h-[72px]" data-header-bar>
    {/* Лого */}
    <a href="/" class="flex items-center gap-2.5 font-display font-extrabold text-xl tracking-tight" aria-label="ГрантПлан — на головну">
      <img src="/images/logo.png" alt="" width="36" height="36" class="h-9 w-9 shrink-0" />
      {/* Текст логотипа — одним flex-елементом: інакше gap контейнера
           розсовує «ГрантПлан» і крапку, і та висить окремо в повітрі. */}
      <span>ГрантПлан<span class="text-accent">.</span></span>
    </a>

    {/* Десктоп-навігація */}
    <nav class="hidden xl:flex items-center gap-6" aria-label="Головна навігація">
      {nav.map((item) => (
        <a href={item.href} class="text-muted hover:text-ink transition-colors text-[0.95rem] whitespace-nowrap">{item.label}</a>
      ))}
    </nav>

    {/* Праворуч */}
    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phone}`}
        class="icon-btn hidden sm:inline-flex hover:text-accent hover:border-accent"
        aria-label="Зателефонувати"
        data-analytics="click_phone"
      >
        <Icon name="phone" size={20} />
      </a>
      <a href="/#lead" class="hidden md:inline-flex btn btn-primary !min-h-[44px] !py-2.5 !px-5 text-[0.95rem] whitespace-nowrap">
        Безкоштовний аудит
      </a>

      {/* "Нагору": живе в шапці, а не плаваючою кнопкою над контентом —
           так воно фізично нічого не перекриває на мобільному. З'являється
           лише після прокрутки (див. скрипт нижче). */}
      <button
        type="button"
        class="icon-btn hover:text-accent hover:border-accent hidden"
        aria-label="Прокрутити на початок сторінки"
        data-scroll-top
      >
        <Icon name="arrow-up" size={20} />
      </button>

      {/* Перемикач теми: на мобільному він у висувному меню (нижче),
           щоб не захаращувати вузьку шапку. */}
      <button
        type="button"
        class="icon-btn hover:text-accent hover:border-accent hidden xl:inline-flex"
        aria-label="Перемкнути тему"
        data-theme-toggle
      >
        <Icon name="sun" size={20} class="icon-sun" />
        <Icon name="moon" size={20} class="icon-moon" />
      </button>

      {/* Бургер */}
      <button
        type="button"
        class="icon-btn xl:hidden"
        aria-label="Відкрити меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

</header>

{/* Повноекранне мобільне меню — навмисно ПОЗА <header>. Під час скролу
     шапка отримує .header-blur з backdrop-filter, а він створює containing
     block для position:fixed нащадків: усередині шапки панель схлопувалась
     до її висоти (64px) і меню не відкривалось після будь-якої прокрутки. */}
<div
  id="mobile-menu"
  class="xl:hidden fixed inset-0 z-[60] bg-bg flex-col hidden overflow-y-auto overscroll-contain"
  data-menu-panel
>
  <div class="container-site flex items-center justify-between h-16">
    <span class="flex items-center gap-2.5 font-display font-extrabold text-xl">
      <img src="/images/logo.png" alt="" width="36" height="36" class="h-9 w-9 shrink-0" />
      <span>ГрантПлан<span class="text-accent">.</span></span>
    </span>
    <button
      type="button"
      class="icon-btn"
      aria-label="Закрити меню"
      data-menu-close
    >
      <Icon name="x" size={22} />
    </button>
  </div>
  {/* Основні розділи — картки з іконками. Голі рядки з волосяними лініями
       читались як список без ієрархії: усі вісім пунктів однакової ваги,
       хоча ведуть вони до дуже різних речей. */}
  <nav class="container-site flex flex-col gap-2 mt-4" aria-label="Мобільна навігація">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={isCurrent(item.href) ? 'page' : undefined}
        class={`group flex items-center gap-3.5 rounded-xl border px-4 py-3 transition-colors ${
          isCurrent(item.href)
            ? 'border-accent bg-accent/10'
            : 'border-border bg-surface hover:border-accent/60'
        }`}
        data-menu-link
      >
        <span
          class={`inline-grid place-items-center w-10 h-10 rounded-lg shrink-0 ${
            isCurrent(item.href) ? 'bg-accent text-accent-ink' : 'bg-accent/10 text-accent'
          }`}
        >
          <Icon name={item.icon} size={20} />
        </span>
        <span class="flex-1 font-display font-semibold text-lg leading-tight">{item.label}</span>
        <Icon name="arrow-right" size={18} class="text-muted group-hover:text-accent transition-colors shrink-0" />
      </a>
    ))}

    {/* Другорядне — однією згрупованою карткою, дрібнішим кеглем:
         так видно, що це додаткове читання, а не рівноцінні розділи. */}
    <div class="mt-2 rounded-xl border border-border bg-surface/60 divide-y divide-border/60">
      {navSecondary.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class={`flex items-center gap-3 px-4 py-3.5 transition-colors hover:text-accent ${
            isCurrent(item.href) ? 'text-accent' : 'text-muted'
          }`}
          data-menu-link
        >
          <Icon name={item.icon} size={18} class="shrink-0" />
          <span class="flex-1 font-display font-semibold text-[0.95rem]">{item.label}</span>
          <Icon name="arrow-right" size={16} class="shrink-0 opacity-60" />
        </a>
      ))}
    </div>
  </nav>
  <div class="container-site mt-6 pb-8 flex flex-col gap-3">
    <a href="/#lead" class="btn btn-primary w-full" data-menu-link>Безкоштовний аудит</a>
    <a href={`tel:${site.phone}`} class="btn btn-ghost w-full" data-analytics="click_phone" data-menu-link>
      <Icon name="phone" size={18} /> Подзвонити
    </a>
    {/* Перемикач теми — утиліта, а не дія: у рамці btn-ghost він важив
         стільки ж, скільки «Подзвонити», і три однакові кнопки поспіль
         зчитувались як три рівноцінні пропозиції. */}
    <button
      type="button"
      class="mt-1 inline-flex items-center justify-center gap-2 min-h-[44px] text-sm text-muted hover:text-accent transition-colors"
      data-theme-toggle
    >
      <Icon name="sun" size={17} class="icon-sun" />
      <Icon name="moon" size={17} class="icon-moon" />
      <span data-theme-label>Змінити тему</span>
    </button>
  </div>
</div>

<script>
  import { trackEvent } from '../lib/analytics';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const headerBar = document.querySelector<HTMLElement>('[data-header-bar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
  let menuLastFocused: HTMLElement | null = null;

  // Панель — повноекранна й непрозора, тож усе, що лишається "позаду",
  // насправді сховане з очей. Без inert клавіатурний користувач міг Tab'ом
  // дійти до посилань у Hero під панеллю, не бачачи, де опинився фокус.
  function setBackgroundInert(shouldBeInert: boolean) {
    headerBar?.toggleAttribute('inert', shouldBeInert);
    Array.from(document.body.children).forEach((el) => {
      // Сама панель тепер сусід <header>, а не його нащадок, — інакше
      // вимкнули б інертністю те саме меню, яке щойно відкрили.
      if (el === header || el === panel || el.tagName === 'SCRIPT') return;
      el.toggleAttribute('inert', shouldBeInert);
    });
  }

  function openMenu() {
    if (!panel || !toggle) return;
    menuLastFocused = document.activeElement as HTMLElement;
    panel.classList.remove('hidden');
    panel.classList.add('flex');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setBackgroundInert(true);
    closeBtn?.focus();
  }
  function closeMenu() {
    if (!panel || !toggle) return;
    panel.classList.add('hidden');
    panel.classList.remove('flex');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setBackgroundInert(false);
    (menuLastFocused ?? toggle).focus();
  }
  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  links.forEach((l) => l.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // blur-фон при скролі + показ кнопки "нагору" (вона в шапці, тож
  // з'являється прямо в панелі, нічого не перекриваючи).
  const topBtn = document.querySelector<HTMLButtonElement>('[data-scroll-top]');
  function onScroll() {
    if (header) {
      if (window.scrollY > 8) header.classList.add('header-blur');
      else header.classList.remove('header-blur');
    }
    topBtn?.classList.toggle('hidden', window.scrollY <= 500);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  topBtn?.addEventListener('click', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    // Фокус на початок контенту — інакше клавіатурний/скрін-рідер користувач
    // лишається "внизу" сторінки, навіть коли візуально вона прокрутилась.
    document.getElementById('main')?.focus();
  });

  // Клацання [data-analytics] відстежуються централізовано в Layout.astro

  // Перемикач теми (світла/темна), збереження вибору в localStorage
  const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  function updateThemeLabels() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const label = isLight ? 'Увімкнути темну тему' : 'Увімкнути світлу тему';
    themeToggles.forEach((btn) => {
      btn.setAttribute('aria-label', label);
      // У мобільному меню кнопка підписана текстом — тримаємо його в парі
      // з aria-label, щоб вони не розходились.
      const text = btn.querySelector('[data-theme-label]');
      if (text) text.textContent = label;
    });
  }
  updateThemeLabels();
  themeToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const next = isLight ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      if (themeMeta) themeMeta.setAttribute('content', next === 'light' ? '#F0E6D3' : '#14181C');
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      updateThemeLabels();
      trackEvent('toggle_theme', { theme: next });
    });
  });
</script>

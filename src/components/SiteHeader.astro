---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
---
<header id="site-header" class="fixed top-0 inset-x-0 z-[60] transition-colors" data-header>
  <div class="container-site flex items-center justify-between h-16 md:h-[72px]" data-header-bar>
    <!-- Лого -->
    <a href="/" class="font-display font-extrabold text-xl tracking-tight" aria-label="ГрантПлан — на головну">
      ГрантПлан<span class="text-accent">.</span>
    </a>

    <!-- Десктоп-навігація -->
    <nav class="hidden xl:flex items-center gap-6" aria-label="Головна навігація">
      {nav.map((item) => (
        <a href={item.href} class="text-muted hover:text-ink transition-colors text-[0.95rem] whitespace-nowrap">{item.label}</a>
      ))}
    </nav>

    <!-- Праворуч -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phone}`}
        class="icon-btn hidden sm:inline-flex hover:text-accent hover:border-accent"
        aria-label="Зателефонувати"
        data-analytics="click_phone"
      >
        <Icon name="phone" size={20} />
      </a>
      <a href="/#lead" class="hidden md:inline-flex btn btn-primary !min-h-[44px] !py-2.5 !px-5 text-[0.95rem] whitespace-nowrap">
        Безкоштовний аудит
      </a>

      <!-- Перемикач теми -->
      <button
        type="button"
        class="icon-btn hover:text-accent hover:border-accent"
        aria-label="Перемкнути тему"
        data-theme-toggle
      >
        <Icon name="sun" size={20} class="icon-sun" />
        <Icon name="moon" size={20} class="icon-moon" />
      </button>

      <!-- Бургер -->
      <button
        type="button"
        class="icon-btn xl:hidden"
        aria-label="Відкрити меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <!-- Повноекранне мобільне меню -->
  <div
    id="mobile-menu"
    class="xl:hidden fixed inset-0 z-[60] bg-bg flex-col hidden overflow-y-auto overscroll-contain"
    data-menu-panel
  >
    <div class="container-site flex items-center justify-between h-16">
      <span class="font-display font-extrabold text-xl">ГрантПлан<span class="text-accent">.</span></span>
      <button
        type="button"
        class="icon-btn"
        aria-label="Закрити меню"
        data-menu-close
      >
        <Icon name="x" size={22} />
      </button>
    </div>
    <nav class="container-site flex flex-col gap-1 mt-6" aria-label="Мобільна навігація">
      {nav.map((item) => (
        <a
          href={item.href}
          class="py-4 text-2xl font-display font-semibold border-b border-border/60"
          data-menu-link
        >{item.label}</a>
      ))}
    </nav>
    <div class="container-site mt-8 flex flex-col gap-3">
      <a href="/#lead" class="btn btn-primary w-full" data-menu-link>Безкоштовний аудит</a>
      <a href={`tel:${site.phone}`} class="btn btn-ghost w-full" data-analytics="click_phone" data-menu-link>
        <Icon name="phone" size={18} /> Подзвонити
      </a>
    </div>
  </div>
</header>

<script>
  import { trackEvent } from '../lib/analytics';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const headerBar = document.querySelector<HTMLElement>('[data-header-bar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
  let menuLastFocused: HTMLElement | null = null;

  // Панель — повноекранна й непрозора, тож усе, що лишається "позаду",
  // насправді сховане з очей. Без inert клавіатурний користувач міг Tab'ом
  // дійти до посилань у Hero під панеллю, не бачачи, де опинився фокус.
  function setBackgroundInert(shouldBeInert: boolean) {
    headerBar?.toggleAttribute('inert', shouldBeInert);
    Array.from(document.body.children).forEach((el) => {
      if (el === header || el.tagName === 'SCRIPT') return;
      el.toggleAttribute('inert', shouldBeInert);
    });
  }

  function openMenu() {
    if (!panel || !toggle) return;
    menuLastFocused = document.activeElement as HTMLElement;
    panel.classList.remove('hidden');
    panel.classList.add('flex');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setBackgroundInert(true);
    closeBtn?.focus();
  }
  function closeMenu() {
    if (!panel || !toggle) return;
    panel.classList.add('hidden');
    panel.classList.remove('flex');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setBackgroundInert(false);
    (menuLastFocused ?? toggle).focus();
  }
  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  links.forEach((l) => l.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // blur-фон при скролі
  function onScroll() {
    if (!header) return;
    if (window.scrollY > 8) header.classList.add('header-blur');
    else header.classList.remove('header-blur');
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Клацання [data-analytics] відстежуються централізовано в Layout.astro

  // Перемикач теми (світла/темна), збереження вибору в localStorage
  const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  function updateThemeLabels() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    themeToggles.forEach((btn) => {
      btn.setAttribute('aria-label', isLight ? 'Увімкнути темну тему' : 'Увімкнути світлу тему');
    });
  }
  updateThemeLabels();
  themeToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const next = isLight ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      if (themeMeta) themeMeta.setAttribute('content', next === 'light' ? '#F0E6D3' : '#14181C');
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      updateThemeLabels();
      trackEvent('toggle_theme', { theme: next });
    });
  });
</script>

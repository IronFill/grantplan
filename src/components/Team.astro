---
// Об'єднує колишні Author.astro і FinancePartner.astro в одну секцію.
// Раніше це були два повноекранні блоки поспіль з однаковою структурою
// (фото + текст + буліти), що читалося як повтор і розтягувало сторінку
// майже на 1300px. Тут — дві рівні колонки: юрист і фінансистка.
import Icon from './Icon.astro';

const people = [
  {
    photo: '/images/team/lawyer-v3.webp',
    alt: 'Юрист, який готує бізнес-плани під грант «Власна справа»',
    role: 'Юрист',
    name: 'Олександр',
    title: 'Хто готує ваш план',
    text: 'Практикуючий юрист із багаторічним досвідом — експерт у кримінальному, економічному та корпоративному праві, а також у консалтингу з кібербезпеки. Знаю, як читає бізнес-план банківський оцінювач, і готую пакет документів, до якого не буває питань. Веду кожен проєкт особисто, без передачі підрядникам. Займаюся волонтерством: допомагаю ветеранам, їхнім родинам і внутрішньо переміщеним особам із працевлаштуванням та відкриттям власної справи.',
    bullets: [
      { icon: 'award', text: 'Багаторічна юридична практика' },
      { icon: 'scale', text: 'Кримінальне, економічне та корпоративне право' },
      { icon: 'shield-check', text: 'Консалтинг із кібербезпеки' },
      { icon: 'handshake', text: 'Волонтерство: працевлаштування ВПО та ветеранів' },
    ],
  },
  {
    photo: '/images/team/finance-v3.webp',
    alt: 'Фінансистка, яка рахує кошторис і податки в бізнес-плані',
    role: 'Фінансистка',
    name: 'Світлана',
    title: 'Хто рахує ваші цифри',
    text: 'Фінансову частину кожного плану — кошторис, податкове навантаження та модель на 3 роки — веде окрема фахівчиня з багаторічним досвідом бухгалтерського й фінансового супроводу бізнесу. Цифри мають витримати перевірку банківського оцінювача, тож рахує їх професійна фінансистка, а не юрист. Поза роботою — активна волонтерка: допомагає внутрішньо переміщеним особам із фінансовою грамотністю та працевлаштуванням.',
    bullets: [
      { icon: 'award', text: 'Багаторічний досвід у фінансах і бухгалтерії' },
      { icon: 'calculator', text: 'Перевірка кожної статті кошторису й податків' },
      { icon: 'file-text', text: 'Розрахунок податків і зборів на 36 місяців' },
      { icon: 'handshake', text: 'Волонтерство: підтримка ВПО з працевлаштуванням' },
    ],
  },
];
---
<section class="py-14 md:py-20 border-t border-border/70 scroll-mt-20">
  <div class="container-site">
    <div class="reveal max-w-2xl">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Двоє на кожному проєкті</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Хто робить вашу роботу</h2>
      <p class="mt-3 text-muted text-lg">
        Не відділ із безіменних виконавців: юрист відповідає за відповідність вимогам, фінансистка — за цифри.
      </p>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-6 lg:gap-8">
      {people.map((p) => (
        <div class="reveal rounded-[20px] bg-surface border border-border p-6 md:p-7 flex flex-col">
          <div class="flex items-start gap-5">
            <img
              src={p.photo}
              alt={p.alt}
              width="560" height="700" loading="lazy" decoding="async"
              class="aspect-[4/5] w-[110px] sm:w-[130px] shrink-0 object-cover rounded-[16px] border border-border"
            />
            <div>
              <span class="inline-flex items-center rounded-full border border-border bg-raised px-3 py-1 text-xs font-medium text-accent">
                {p.role}
              </span>
              <h3 class="mt-3 text-xl font-display font-semibold">{p.name}</h3>
              <p class="mt-0.5 text-sm text-muted">{p.title}</p>
            </div>
          </div>

          <p class="mt-5 text-muted leading-relaxed flex-1">{p.text}</p>

          <ul class="mt-6 pt-5 border-t border-border/70 space-y-3">
            {p.bullets.map((b) => (
              <li class="flex items-center gap-3">
                <span class="inline-grid place-items-center w-9 h-9 rounded-lg bg-accent/10 text-accent shrink-0">
                  <Icon name={b.icon} size={18} />
                </span>
                <span class="text-sm font-medium">{b.text}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

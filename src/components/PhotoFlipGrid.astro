---
// Сітка реальних фото кейсу з м'якою 3D-анімацією: кожна картка по черзі
// перевертається, показуючи підпис на звороті. Каскад — картки перевертаються
// не одночасно, а по черзі (animation-delay зростає з індексом).
//
// Підпис лишається і під фото (як було), тому анімація суто декоративна:
// під prefers-reduced-motion картка просто завмирає лицем до глядача —
// жодна інформація не губиться.
interface Photo {
  src: string;
  alt: string;
  caption: string;
}
interface Props {
  photos: Photo[];
  gridClass?: string;
  aspectClass?: string;
  wrapperClass?: string;
}
const {
  photos,
  gridClass = 'grid-cols-2 sm:grid-cols-4',
  aspectClass = 'aspect-[4/3]',
  wrapperClass = '',
} = Astro.props;
---
<div class={`grid ${gridClass} gap-3 ${wrapperClass}`}>
  {photos.map((p, i) => (
    <figure class="reveal">
      <div class={`flip-card ${aspectClass}`} style={`--i: ${i}`}>
        <div class="flip-card-inner">
          <div class="flip-card-face flip-card-front">
            <img src={p.src} alt={p.alt}
              width="1200" height="900" loading="lazy" decoding="async"
              class="w-full h-full object-cover" />
          </div>
          <div class="flip-card-face flip-card-back">
            <span class="flip-card-label">Реальне фото</span>
            <span class="flip-card-caption">{p.caption}</span>
          </div>
        </div>
      </div>
      <figcaption class="mt-2 text-xs text-muted text-center">{p.caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .flip-card {
    position: relative;
    width: 100%;
    perspective: 1200px;
  }
  .flip-card-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation: flip-loop 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.9s);
  }
  .flip-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .flip-card-front img {
    display: block;
  }
  .flip-card-back {
    transform: rotateY(180deg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem;
    text-align: center;
  }
  .flip-card-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .flip-card-caption {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-muted);
  }
  @keyframes flip-loop {
    0%, 40% { transform: rotateY(0deg); }
    50%, 90% { transform: rotateY(180deg); }
    100% { transform: rotateY(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner {
      animation: none !important;
    }
  }
</style>

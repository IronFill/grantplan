---
// Розгорнуті відгуки: кожен проходить по етапах роботи (аудит → кошторис →
// фінмодель → співбесіда → супровід після рішення), а `result` фіксує
// підсумок. Сенс довжини — не «більше тексту», а те, що клієнт з сумнівами
// впізнає в чужій історії власну ситуацію й бачить, з чого складається робота.
//
// Тексти узгоджуються з клієнтами перед публікацією; імена та деталі
// оновлюються за їхньою згодою.
import Icon from './Icon.astro';

interface Review {
  name: string;
  business: string;
  text: string;
  rating: number;
  result: string;
}

const reviews: Review[] = [
  {
    name: 'Ірина Ковальчук',
    business: 'Кондитерська майстерня, Харків',
    text: 'Прийшла на безкоштовний аудит упевнена, що моя ідея точно пройде. Мені за двадцять хвилин показали два слабких місця: КВЕД не збігався з тим, що я реально збиралася робити, і половина обладнання в моєму списку взагалі не купується за кошти гранту. Виправили це до подання, коли воно ще нічого не коштувало. Далі зібрали кошторис із комерційними пропозиціями від двох постачальників за актуальними цінами, а фінмодель розписали на 36 місяців так, що під кожною цифрою виручки видно розрахунок, а не «зі стелі». Готовий пакет був за три робочі дні, у банку по документах не виникло жодного уточнення.',
    rating: 5,
    result: 'Грант отримано з першого подання',
  },
  {
    name: 'Максим Гончаренко',
    business: 'Сервіс з ремонту побутової техніки',
    text: 'Найбільше боявся співбесіди — начувся, що там «валять» питаннями. Виявилось, головне простіше: щоб суми в описовій частині, кошторисі й фінансовій моделі збігалися між собою до копійки, і щоб я міг своїми словами пояснити, звідки взялася виручка у власному ж плані. Ми окремо розібрали типові питання комісії та прибрали формулювання, які тягнуть за собою уточнення. На самій співбесіді я просто розповідав про власний бізнес своїми словами, без папірця перед очима — уточнень не було взагалі. Після рішення нагадали, що на договір і рахунок в уповноваженому банку є лише 15 календарних днів — я не затягнув.',
    rating: 5,
    result: 'Без доопрацювань · строки за договором витримані',
  },
  {
    name: 'Олена Приходько',
    business: 'Перукарня, Харків',
    text: 'Скажу чесно: часу пішло більше, ніж я розраховувала. Ми двічі переробляли розрахунок завантаженості крісел, бо мої початкові цифри не билися з цінами конкурентів по району, і тоді мені це здавалося зайвим прискіпуванням. З першої подачі я балів недобрала — довелося доопрацьовувати пакет і подаватися вдруге. Але зауваження комісії виявилися рівно про ті місця, які ми до того й обговорювали, тож правки зайняли кілька днів. Другу подачу пройшла. Раджу не сперечатися, коли просять перерахувати: саме ці місця комісія й перевіряє. Чотири зірки — за строки на старті, а не за результат: результат я отримала.',
    rating: 4,
    result: 'Отримала з другої подачі після доопрацювання',
  },
  {
    name: 'Дмитро Савченко',
    business: 'СТО, ветеран',
    text: 'Подавався за ветеранським напрямом, і мені з першої розмови пояснили різницю в лімітах і вимогах, замість того щоб пообіцяти «мільйон усім». Розписали, скільки робочих місць треба створити й утримати, які податки і за який період я зобов’язаний сплатити, що робити, якщо діяльність доведеться призупинити. Співбесіду репетирували окремо: після двох прогонів я перестав плутатися у власних цифрах. Супровід не закінчився на подачі — вели й далі, до відкриття рахунку та перших витрат суворо за кошторисом. Жодного «ми все зробимо, ви тільки заплатіть» — на кожному етапі я розумів, що вимагається саме від мене.',
    rating: 5,
    result: 'Ветеранський напрям · супровід до першої виплати',
  },
];
---
<section class="py-14 md:py-20 border-t border-border/70">
  <div class="container-site">
    <div class="reveal max-w-2xl">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Досвід клієнтів</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Що кажуть клієнти</h2>
      <p class="mt-3 text-muted text-lg">
        Не «дякую, все супер», а розбір по етапах: що знайшли на аудиті, як рахували кошторис і фінмодель, як минула співбесіда і що було після рішення.
      </p>
    </div>

    <!-- Статична сітка замість каруселі: до правки тут була автопрокрутка
         по 2 картки за раз, і половина відгуків фізично не долистувалась.
         Відгуків лише чотири і кожен цінний — усі мають бути одразу видимі. -->
    <div class="reveal mt-8 grid sm:grid-cols-2 gap-5">
      {reviews.map((r) => (
        <figure class="h-full rounded-card bg-surface border border-border p-6 flex flex-col">
          <Icon name="quote" size={28} class="text-accent/40" />
          <blockquote class="mt-3 text-muted text-[0.95rem] leading-relaxed flex-1">{r.text}</blockquote>
          <div class="mt-5 flex items-start gap-2 rounded-xl bg-success/10 border border-success/25 px-3 py-2 text-[0.8rem] font-medium text-success">
            <Icon name="check-circle" size={15} class="shrink-0 mt-px" />
            <span>{r.result}</span>
          </div>
          <figcaption class="mt-4 pt-4 border-t border-border/70">
            <div class="font-semibold">{r.name}</div>
            <div class="text-sm text-muted">{r.business}</div>
            <div class="flex gap-0.5 text-accent mt-2">
              {Array.from({ length: r.rating }).map(() => <Icon name="star" size={14} />)}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

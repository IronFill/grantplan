---
// Банер згоди на cookies. Показується, лише поки немає збереженого рішення
// в localStorage. Plausible активний завжди (без cookies, згода не потрібна);
// GA4 і Meta Pixel вантажаться лише після «Прийняти» — див. src/lib/analytics.ts.
---
<div
  id="cookie-consent"
  class="hidden fixed inset-x-0 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] lg:bottom-0 lg:pb-[env(safe-area-inset-bottom)] z-50 border-t border-border bg-surface"
  role="dialog"
  aria-live="polite"
  aria-label="Згода на використання cookies"
>
  {/* Мобільна нижня CTA-панель (MobileCta) має висоту 74px + safe-area-inset-bottom.
       Банер стоїть над нею з тим самим відступом: з фіксованими 5rem на iPhone
       із «домашньою смугою» він налазив би на панель. Компактніший текст і
       кнопки в один ряд забирають менше висоти першого екрана. */}
  <div class="container-site py-3 sm:py-4 flex flex-col sm:flex-row sm:items-center gap-2.5 sm:gap-6">
    <p class="text-xs leading-snug sm:text-sm sm:leading-normal text-muted flex-1">
      Використовуємо cookies для аналітики й реклами (Google, Meta), щоб бачити, які матеріали справді допомагають. До згоди ці сервіси не вантажаться. Детальніше — у <a href="/privacy" class="text-accent underline">політиці конфіденційності</a>.
    </p>
    <div class="flex gap-2 sm:shrink-0">
      <button type="button" id="cookie-decline" class="btn btn-ghost flex-1 sm:flex-none !min-h-[44px] !py-0 !px-4 text-sm">Тільки необхідні</button>
      <button type="button" id="cookie-accept" class="btn btn-primary flex-1 sm:flex-none !min-h-[44px] !py-0 !px-4 text-sm">Прийняти</button>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent, loadConsentedAnalytics } from '../lib/analytics';

  const banner = document.getElementById('cookie-consent');
  if (banner) {
    if (getConsent() === null) {
      banner.classList.remove('hidden');
    }
    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      setConsent('granted');
      loadConsentedAnalytics();
      banner.classList.add('hidden');
    });
    document.getElementById('cookie-decline')?.addEventListener('click', () => {
      setConsent('denied');
      banner.classList.add('hidden');
    });
  }
</script>

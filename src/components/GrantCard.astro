---
import Icon from './Icon.astro';
import type { GrantProgram } from '../data/granty';
import { STATUS, KIND, CATEGORY_GROUPS, effectiveStatus, formatAmount, formatPeriod, visibleCategories } from '../lib/granty.js';

interface Props {
  p: GrantProgram;
  today: string;
}
const { p, today } = Astro.props;

const status = effectiveStatus(p, today);
const info = STATUS[status as keyof typeof STATUS];
const amount = formatAmount(p);
const period = formatPeriod(p, today);
const cats = visibleCategories(p);

// Групи фільтра, під які підпадає карточка: клієнтський скрипт читає їх з data-атрибутів.
const catGroups = Object.entries(CATEGORY_GROUPS)
  .filter(([, g]) => p.categories.includes('any') || p.categories.some((c) => g.members.includes(c)))
  .map(([key]) => key)
  .join(' ');

const tone: Record<string, string> = {
  success: 'bg-success/10 text-success',
  accent: 'bg-accent/10 text-accent',
  muted: 'border border-border text-muted',
};
---
<a
  href={`/granty/${p.id}`}
  class="reveal card-hover block rounded-card bg-surface border border-border p-6"
  data-grant-card
  data-status={p.status}
  data-closes={p.period.closes ?? ''}
  data-kind={p.kind}
  data-entities={p.entities.join(' ')}
  data-cats={catGroups}
  data-text={`${p.title} ${p.short} ${p.operator.name ?? ''}`.toLowerCase()}
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="inline-flex items-center rounded-full bg-accent/10 text-accent px-2.5 py-1 font-medium">{KIND[p.kind].label}</span>
    <span data-status-badge class={'inline-flex items-center rounded-full px-2.5 py-1 font-medium ' + tone[info.tone]}>{info.label}</span>
    {!p.verified && status !== 'closed' && (
      <span class="inline-flex items-center rounded-full border border-border px-2.5 py-1 text-muted">Частину умов звіряємо</span>
    )}
  </div>
  <h2 class="mt-3 text-xl font-display font-semibold">{p.title}</h2>
  <p class="mt-2 text-muted leading-relaxed">{p.short}</p>
  <dl class="mt-4 grid gap-1.5 text-sm">
    {amount && (
      <div class="flex gap-2"><dt class="text-muted shrink-0">Сума:</dt><dd class="font-medium">{amount}</dd></div>
    )}
    {period && (
      <div class="flex gap-2"><dt class="text-muted shrink-0">Строки:</dt><dd>{period}</dd></div>
    )}
    {cats.length > 0 && (
      <div class="flex gap-2"><dt class="text-muted shrink-0">Для кого:</dt><dd>{cats.join(', ')}</dd></div>
    )}
  </dl>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
    Умови й що перевірити <Icon name="arrow-right" size={15} />
  </span>
</a>

---
// Публічні коментарі відвідувачів. На відміну від Reviews.astro (куровані
// відгуки клієнтів, додаються вручну після згоди), тут будь-хто може лишити
// повідомлення напряму із сайту — ім'я+прізвище та email обов'язкові,
// напрямок діяльності необов'язковий. Email ніколи не показується публічно
// (лише зберігається на бекенді для зв'язку/захисту від спаму). Дані живуть
// у /comments (Netlify Blobs, парний ендпоінт — functions/comments.js для
// Cloudflare Pages).
import Icon from './Icon.astro';
---
<section id="comments" class="py-14 md:py-20 border-t border-border/70 scroll-mt-20">
  <div class="container-site max-w-3xl">
    <div class="reveal">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Обговорення</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Коментарі</h2>
      <p class="mt-3 text-muted text-lg">
        Питання чи власний досвід — пишіть нижче. Email потрібен лише щоб з вами можна було зв’язатись і публічно не показується; ім’я, прізвище та напрямок діяльності видно всім.
      </p>
    </div>

    <form id="comments-form" novalidate class="reveal mt-8 rounded-card-lg bg-surface border border-border p-5 md:p-6 space-y-4">
      <!-- Honeypot -->
      <div class="hidden" aria-hidden="true">
        <label>Не заповнюйте це поле<input type="text" name="hp_gp_comment" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="cm-name" class="block text-sm font-medium mb-1.5">Ім’я та прізвище <span class="text-accent">*</span></label>
          <input
            id="cm-name" name="name" type="text" required autocomplete="name" maxlength="80"
            class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted/70 focus:border-accent outline-none"
            placeholder="Ваше ім’я та прізвище"
          />
        </div>
        <div>
          <label for="cm-email" class="block text-sm font-medium mb-1.5">Email <span class="text-accent">*</span></label>
          <input
            id="cm-email" name="email" type="email" required autocomplete="email" maxlength="120"
            class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted/70 focus:border-accent outline-none"
            placeholder="you@example.com"
          />
          <p class="mt-1 text-xs text-muted">Не публікується — лише для зв’язку.</p>
        </div>
      </div>

      <div>
        <label for="cm-business" class="block text-sm font-medium mb-1.5">Напрямок діяльності <span class="text-muted font-normal">(необов’язково)</span></label>
        <input
          id="cm-business" name="business" type="text" autocomplete="off" maxlength="100"
          class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted/70 focus:border-accent outline-none"
          placeholder="Наприклад: кондитерська, СТО, перукарня"
        />
      </div>

      <div>
        <label for="cm-text" class="block text-sm font-medium mb-1.5">Коментар <span class="text-accent">*</span></label>
        <textarea
          id="cm-text" name="text" rows="4" required minlength="5" maxlength="1000"
          class="w-full rounded-xl bg-raised border border-border px-4 py-3 text-base placeholder:text-muted/70 focus:border-accent outline-none resize-y"
          placeholder="Ваше запитання або коментар"
        ></textarea>
      </div>

      <label class="flex items-start gap-3 text-sm text-muted">
        <input type="checkbox" name="consent" required class="mt-1 w-4 h-4 accent-[#E86A00] shrink-0" />
        <span>Погоджуюсь на обробку персональних даних згідно з <a href="/privacy" class="text-accent underline">політикою конфіденційності</a></span>
      </label>

      <div class="flex items-center gap-4">
        <button type="submit" class="btn btn-primary" data-cm-submit>
          <Icon name="send" size={18} /> Надіслати
        </button>
        <p class="text-sm hidden" data-cm-status></p>
      </div>
    </form>

    <div data-cm-list class="reveal mt-8 space-y-4">
      <p data-cm-empty class="text-muted text-sm hidden">Поки що немає коментарів — будьте першими.</p>
      <p data-cm-loading class="text-muted text-sm">Завантажуємо коментарі…</p>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('comments');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('#comments-form');
    const listWrap = root.querySelector<HTMLElement>('[data-cm-list]');
    const emptyEl = root.querySelector<HTMLElement>('[data-cm-empty]');
    const loadingEl = root.querySelector<HTMLElement>('[data-cm-loading]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-cm-submit]');
    const statusEl = root.querySelector<HTMLElement>('[data-cm-status]');

    interface Comment {
      id: string;
      name: string;
      business?: string;
      text: string;
      createdAt: string;
    }

    const fmtDate = (iso: string) => {
      try {
        return new Date(iso).toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });
      } catch {
        return '';
      }
    };

    function renderCard(c: Comment): HTMLElement {
      const card = document.createElement('article');
      card.className = 'rounded-card bg-surface border border-border p-5';

      const head = document.createElement('div');
      head.className = 'flex items-baseline justify-between gap-3';

      const name = document.createElement('span');
      name.className = 'font-semibold';
      name.textContent = c.name; // textContent — без ризику XSS, навіть якщо бекенд колись пропустить зайве

      const date = document.createElement('span');
      date.className = 'text-xs text-muted shrink-0';
      date.textContent = fmtDate(c.createdAt);

      head.append(name, date);
      card.append(head);

      if (c.business) {
        const business = document.createElement('div');
        business.className = 'text-sm text-muted';
        business.textContent = c.business;
        card.append(business);
      }

      const text = document.createElement('p');
      text.className = 'mt-2 text-muted text-[0.95rem] leading-relaxed whitespace-pre-line';
      text.textContent = c.text;

      card.append(text);
      return card;
    }

    function renderList(comments: Comment[]) {
      listWrap?.querySelectorAll('article').forEach((el) => el.remove());
      loadingEl?.classList.add('hidden');
      if (!comments.length) {
        emptyEl?.classList.remove('hidden');
        return;
      }
      emptyEl?.classList.add('hidden');
      comments.forEach((c) => listWrap?.appendChild(renderCard(c)));
    }

    function prependComment(c: Comment) {
      emptyEl?.classList.add('hidden');
      listWrap?.insertBefore(renderCard(c), listWrap.firstElementChild);
    }

    function showStatus(msg: string, isError = false) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = 'text-sm ' + (isError ? 'text-accent-hover' : 'text-success');
      statusEl.classList.remove('hidden');
    }

    async function loadComments() {
      try {
        const res = await fetch('/comments');
        if (!res.ok) throw new Error('bad response');
        const data = await res.json();
        renderList(Array.isArray(data.comments) ? data.comments : []);
      } catch {
        loadingEl?.classList.add('hidden');
        if (emptyEl) {
          emptyEl.textContent = 'Не вдалося завантажити коментарі. Спробуйте оновити сторінку.';
          emptyEl.classList.remove('hidden');
        }
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;

      const hp = (form.elements.namedItem('hp_gp_comment') as HTMLInputElement)?.value;
      if (hp) return; // бот

      const name = (form.elements.namedItem('name') as HTMLInputElement)?.value.trim();
      const business = (form.elements.namedItem('business') as HTMLInputElement)?.value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement)?.value.trim();
      const text = (form.elements.namedItem('text') as HTMLTextAreaElement)?.value.trim();
      const consent = (form.elements.namedItem('consent') as HTMLInputElement)?.checked;

      if (!name || name.trim().split(/\s+/).length < 2) {
        showStatus('Вкажіть, будь ласка, ім’я та прізвище.', true);
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showStatus('Вкажіть коректний email.', true);
        return;
      }
      if (!text || text.length < 5) {
        showStatus('Коментар закороткий.', true);
        return;
      }
      if (!consent) {
        showStatus('Потрібна згода на обробку персональних даних.', true);
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      showStatus('Надсилаємо…');

      try {
        const res = await fetch('/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, business, email, text }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'send_failed');

        if (data.comment) prependComment(data.comment);
        form.reset();
        showStatus('Дякуємо! Коментар опубліковано.');
      } catch {
        showStatus('Не вдалося надіслати. Спробуйте ще раз трохи пізніше.', true);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    loadComments();
  }
</script>

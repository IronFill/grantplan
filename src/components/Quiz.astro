---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getProgramPhase } from '../data/program';

// Поки нова модель не стартувала, число з квізу порахував би старий
// порядок — тож підписуємо його чесно замість того, щоб мовчки видавати
// суму за редакцією, яка вже не діє.
const quizNote =
  getProgramPhase() === 'new-open'
    ? 'Це орієнтир за постановою КМУ № 616, чинною з 1 вересня 2026: базовий діапазон напряму плюс надбавки, які підсумовуються, але не вище стелі. Два уточнення, які вирішуються не на сайті: належність до пріоритетного сектору визначає центр зайнятості за КВЕД під час розгляду заяви, а критерії оцінювання встановлює Мінекономіки окремим актом. Тому точну суму рахуємо на безкоштовному аудиті.'
    : 'Розрахунок за редакцією, що приймала заявки до 1 серпня 2026 року. З 1 вересня діють гнучкі діапазони з системою надбавок, тож ваша фактична сума може відрізнятися — перерахуємо її на безкоштовному аудиті за правилами, чинними на дату подання.';

const questions = [
  {
    // Статус вирішує не лише прохідність, а й доступний напрям: масштабування
    // пункт 6 Порядку дає лише суб'єктам господарювання з підпункту 2 пункту 4.
    q: 'Ваш статус?',
    key: 'status',
    options: ['Фізособа — ще не зареєстрований', 'ФОП', 'Юридична особа'],
  },
  {
    // З 1 вересня 2026 сума залежить насамперед від напряму, а не від
    // категорії заявника, — тож питаємо про це одразу після статусу.
    q: 'Ви відкриваєте нову справу чи масштабуєте діючу?',
    key: 'track',
    options: ['Відкриваю нову', 'Масштабую діючу'],
  },
  {
    q: 'Скільки робочих місць готові створити?',
    key: 'jobs',
    options: ['0', '1', '2 і більше'],
  },
  {
    q: 'Область реєстрації?',
    key: 'region',
    options: ['Харківська чи інша прифронтова', 'Інша область'],
  },
  {
    // Пункт 10 Порядку дає вибір строку проєкту: 2, 3 або 5 років. Питати
    // «чи готові 3 роки?» означало б відсіювати тих, кому підходять два.
    q: 'На який строк готові взяти зобов’язання — працювати офіційно і платити податки?',
    key: 'term',
    options: ['2 роки', '3 роки', '5 років', 'Не готовий(-а)'],
  },
];

// Підстави для збільшення суми (пункт 6 Порядку). Мультивибір, бо вони
// сумуються: «у разі одночасної наявності двох і більше умов … збільшення
// застосовується шляхом сумування відповідних відсотків». Прифронтовий
// регіон і два робочі місця — теж підстави, але їх питаємо окремо вище.
const bonusGrounds = [
  {
    id: 'sector',
    pct: 50,
    label: 'Діяльність у пріоритетному секторі економіки',
    short: 'пріоритетний сектор економіки',
    hint: 'промисловість і харчова, агро, IT, будівництво й відновлення, транспорт, енергетика, ОПК, охорона здоров’я, креативні індустрії, освіта, кібербезпека та інші — повний перелік КВЕД у додатку до Порядку',
  },
  {
    id: 'rebuild',
    pct: 30,
    label: 'Оновлення основних засобів, знищених або пошкоджених війною',
    short: 'оновлення зруйнованих основних засобів',
  },
  { id: 'veteran', pct: 20, label: 'Суб’єкт ветеранського підприємництва', short: 'ветеранське підприємництво' },
  { id: 'vat', pct: 20, label: 'Зареєстровані платником ПДВ', short: 'платник ПДВ' },
  {
    id: 'patent',
    pct: 20,
    label: 'Чинний патент на винахід або корисну модель за темою проєкту',
    short: 'чинний патент',
  },
  {
    id: 'idp',
    pct: 20,
    label: 'ВПО з досвідом підприємництва понад 6 місяців або релоковане підприємство',
    short: 'ВПО або релоковане підприємство',
  },
  { id: 'young', pct: 5, label: 'Вам від 18 до 25 років', short: 'вік 18–25' },
];

// Жорсткий відсів — пункти 9 і 19 Порядку: заявку відхиляють автоматично,
// бізнес-план ніхто не читатиме.
const hardBlockers = [
  { id: 'tot', label: 'Бізнес зареєстрований або фактично працює на тимчасово окупованій території чи в зоні активних бойових дій' },
  { id: 'rf', label: 'Є господарська діяльність на території РФ або Білорусі' },
  { id: 'sanctions', label: 'Щодо вас або компанії застосовані санкції' },
  { id: 'bankrupt', label: 'Порушено справу про банкрутство або триває ліквідація' },
  { id: 'criminal', label: 'Є рішення суду у кримінальній справі, зокрема за корупційні злочини' },
  { id: 'activity', label: 'Зброя, тютюн, алкоголь (крім вина та медових напоїв), обмін валют' },
  { id: 'finance', label: 'Ломбард, кредитна чи страхова організація, інвестфонд, НПФ, професійний учасник ринку цінних паперів' },
  { id: 'fund', label: 'Уже отримували грант Українського молодіжного або ветеранського фонду на ті самі напрями витрат' },
  { id: 'five', label: 'Ви керівник, засновник або кінцевий бенефіціар у п’яти й більше платниках податків' },
];

// М'який відсів — критерії перевірки ділової репутації (пункт 17). Це не
// автоматична відмова, але негативна репутація хоча б за одним критерієм
// уже є підставою для відмови (пункт 19), тож мовчати про це не можна.
const softBlockers = [
  { id: 'taxdebt', label: 'Є податковий борг' },
  { id: 'enforcement', label: 'Є відкриті виконавчі провадження, де ви боржник' },
  { id: 'overdue', label: 'Є прострочені кредити або інші прострочені зобов’язання' },
];

const totalSteps = questions.length + 2;

// Ліва колонка описує рівно те, що питає сам тест, — список зібрано під
// questions/blockers вище, щоб він не розійшовся з реальними кроками.
const checks = [
  'Ваш статус: фізособа, ФОП чи юридична особа',
  'Напрям: нова справа чи масштабування діючої',
  'Скільки робочих місць готові створити',
  'Область реєстрації — прифронтова чи ні',
  'Строк зобов’язань: 2, 3 або 5 років',
  `${bonusGrounds.length} підстав для надбавок — від +5% до +50%`,
  `${hardBlockers.length} блокуючих умов, які банк перевіряє першими`,
];
---
{/* Секція в тому самому .container-site, що й решта головної. Ліворуч —
     опис тесту, праворуч — сама картка: раніше блок був звужений до 768px
     і «провалювався» по ширині між сусідніми секціями. */}
<section id="quiz" class="py-14 md:py-20 scroll-mt-20 bg-surface/30">
  <div class="container-site grid lg:grid-cols-[0.9fr_1.25fr] gap-10 lg:gap-14 items-start">
    <div class="reveal lg:sticky lg:top-24">
      <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Скоринг шансів</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Чи підходить вам грант?</h2>
      <p class="mt-3 text-muted text-lg">
        {totalSteps} коротких питань — і ви побачите орієнтовний ліміт, блокуючі умови та наступні кроки. Без реєстрації.
      </p>

      <div class="mt-8">
        <h3 class="font-display font-semibold text-sm uppercase tracking-wide text-muted">Що перевіряємо</h3>
        <ul class="mt-4 space-y-2.5">
          {checks.map((c) => (
            <li class="flex items-start gap-3 text-[0.95rem] leading-snug">
              <Icon name="check" size={16} class="text-success shrink-0 mt-1" />
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <p class="mt-7 flex items-start gap-2.5 text-sm text-muted">
        <Icon name="shield" size={16} class="text-accent shrink-0 mt-0.5" />
        <span>Відповіді бачите лише ви — нам вони потраплять, тільки якщо самі залишите контакти в кінці.</span>
      </p>
    </div>

    <div class="reveal rounded-card-lg bg-raised border border-border p-6 md:p-10 relative overflow-hidden" data-quiz>
      <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full blur-[110px] opacity-15" style="background:radial-gradient(circle,var(--color-accent),transparent 70%)" aria-hidden="true"></div>

      {/* Інтро */}
      <div class="relative text-center" data-quiz-intro>
        <span class="inline-grid place-items-center w-14 h-14 rounded-2xl bg-accent/15 text-accent mx-auto">
          <Icon name="sparkles" size={28} />
        </span>
        <p class="mt-5 font-display font-semibold text-xl sm:text-2xl">{totalSteps} питань — і ви побачите свій ліміт</p>
        <p class="mt-3 text-muted max-w-md mx-auto">Займе близько хвилини — результат одразу на екрані.</p>
        <button type="button" class="btn btn-primary mt-7" data-quiz-start>Почати тест</button>
      </div>

      {/* Кроки */}
      <div class="relative hidden" data-quiz-steps>
        {/* Прогрес */}
        <div class="flex items-center justify-between text-sm text-muted mb-2">
          <span data-quiz-counter>Питання 1 з {totalSteps}</span>
          <button type="button" class="hover:text-ink" data-quiz-back hidden>← Назад</button>
        </div>
        <div class="h-1.5 rounded-full bg-border overflow-hidden">
          <div class="h-full bg-accent transition-all duration-300" style="width:20%" data-quiz-progress></div>
        </div>

        {questions.map((question, qi) => (
          <div class={qi === 0 ? 'mt-7' : 'mt-7 hidden'} data-quiz-q={qi}>
            <h3 class="text-xl sm:text-2xl font-display font-semibold">{question.q}</h3>
            <div class="mt-5 grid gap-3">
              {question.options.map((opt) => (
                <button
                  type="button"
                  class="text-left rounded-xl border border-border bg-surface px-5 py-4 hover:border-accent transition-colors flex items-center justify-between group"
                  data-quiz-opt data-key={question.key} data-value={opt}
                >
                  <span>{opt}</span>
                  <Icon name="arrow-right" size={18} class="text-muted group-hover:text-accent transition-colors" />
                </button>
              ))}
            </div>
          </div>
        ))}

        {/* Передостанній крок: підстави для надбавок (мультивибір — вони сумуються) */}
        <div class="mt-7 hidden" data-quiz-q={questions.length} data-quiz-grounds>
          <h3 class="text-xl sm:text-2xl font-display font-semibold">
            Що з переліченого стосується вас або вашого проєкту?
          </h3>
          <p class="mt-2 text-sm text-muted">
            Кожен пункт додає відсотки до базової суми, і вони підсумовуються. Позначайте все, що підходить.
          </p>
          <div class="mt-5 grid gap-2.5">
            {bonusGrounds.map((g) => (
              <label class="flex items-start gap-3 text-left rounded-xl border border-border bg-surface px-5 py-4 cursor-pointer hover:border-accent transition-colors">
                <input
                  type="checkbox"
                  class="mt-1 w-4 h-4 accent-accent shrink-0"
                  data-ground
                  value={g.id}
                  data-pct={g.pct}
                  data-label={g.label}
                  data-short={g.short}
                />
                <span class="flex-1 min-w-0">
                  <span class="block text-[0.95rem] leading-snug">{g.label}</span>
                  {g.hint && <span class="block mt-1 text-xs text-muted leading-relaxed">{g.hint}</span>}
                </span>
                <span class="font-display font-semibold text-accent text-sm shrink-0">+{g.pct}%</span>
              </label>
            ))}
            <label class="flex items-start gap-3 text-left rounded-xl border border-border bg-raised px-5 py-4 cursor-pointer hover:border-accent transition-colors">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-accent shrink-0" data-ground-none />
              <span class="text-[0.95rem] leading-snug font-medium">Нічого з переліченого</span>
            </label>
          </div>
          <button type="button" class="btn btn-primary w-full mt-5" data-quiz-next>Далі</button>
        </div>

        {/* Останній крок: блокуючі умови (мультивибір) */}
        <div class="mt-7 hidden" data-quiz-q={questions.length + 1} data-quiz-blockers>
          <h3 class="text-xl sm:text-2xl font-display font-semibold">
            Позначте те, що стосується вас або вашого бізнесу
          </h3>
          <p class="mt-2 text-sm text-muted">
            Ці умови банк-партнер перевіряє першими — ще до того, як хтось прочитає ваш бізнес-план.
          </p>
          <div class="mt-5 grid gap-2.5">
            {hardBlockers.map((b) => (
              <label class="flex items-start gap-3 text-left rounded-xl border border-border bg-surface px-5 py-4 cursor-pointer hover:border-accent transition-colors">
                <input type="checkbox" class="mt-1 w-4 h-4 accent-accent shrink-0" data-blocker value={b.id} data-label={b.label} />
                <span class="text-[0.95rem] leading-snug">{b.label}</span>
              </label>
            ))}
          </div>

          {/* Окремим блоком, бо це інша природа: не автоматична відмова,
               а бали ділової репутації, які банк рахує на першому етапі. */}
          <p class="mt-6 text-sm font-medium">А це впливає на бали перевірки в банку:</p>
          <div class="mt-2.5 grid gap-2.5">
            {softBlockers.map((b) => (
              <label class="flex items-start gap-3 text-left rounded-xl border border-border bg-surface/60 px-5 py-4 cursor-pointer hover:border-accent transition-colors">
                <input type="checkbox" class="mt-1 w-4 h-4 accent-accent shrink-0" data-soft value={b.id} data-label={b.label} />
                <span class="text-[0.95rem] leading-snug text-muted">{b.label}</span>
              </label>
            ))}
            <label class="flex items-start gap-3 text-left rounded-xl border border-border bg-raised px-5 py-4 cursor-pointer hover:border-accent transition-colors">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-accent shrink-0" data-blocker-none />
              <span class="text-[0.95rem] leading-snug font-medium">Нічого з переліченого</span>
            </label>
          </div>
          <button type="button" class="btn btn-primary w-full mt-5" data-quiz-finish>Показати результат</button>
        </div>
      </div>

      {/* Результат */}
      <div class="relative hidden text-center" data-quiz-result>
        <span class="inline-grid place-items-center w-14 h-14 rounded-2xl mx-auto" data-result-icon></span>
        <h3 class="mt-5 text-2xl sm:text-3xl" data-result-title></h3>
        <p class="mt-3 text-muted max-w-lg mx-auto" data-result-text></p>
        {/* Ліміт рахується за редакцією, що діяла до 1 серпня 2026. Поки
             не опубліковано параметри нової моделі, показуємо число як
             орієнтир і одразу поруч кажемо, за якою редакцією воно
             пораховане, — інакше вийшло б, що сайт називає точну суму за
             правилами, яких уже немає. */}

        <div class="mt-4 mx-auto max-w-lg rounded-card border border-accent/40 bg-accent/5 px-4 py-3 text-left text-sm leading-relaxed hidden" data-result-roi></div>

        <p class="mt-4 mx-auto max-w-lg rounded-card border border-border bg-surface px-4 py-3 text-left text-xs text-muted leading-relaxed hidden" data-result-note>
          {quizNote}
        </p>

        {/* Захоплення контакту */}
        <form class="mt-7 max-w-md mx-auto text-left" data-quiz-form>
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label>Не заповнюйте<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
          <p class="text-sm text-muted mb-3 text-center">Надішлемо розрахунок і план дій:</p>
          <div class="grid sm:grid-cols-2 gap-3">
            <input name="name" type="text" required placeholder="Ім’я"
              class="rounded-xl bg-surface border border-border px-4 py-3 focus:border-accent outline-none" />
            <div>
              <input name="phone" type="tel" required inputmode="tel" value="+380" placeholder="+380 __ ___ __ __"
                class="w-full rounded-xl bg-surface border border-border px-4 py-3 focus:border-accent outline-none"
                aria-describedby="quiz-phone-error" data-quiz-phone />
              <p id="quiz-phone-error" class="mt-1 text-xs hidden text-accent-hover" role="alert" data-quiz-phone-error>Введіть коректний номер у форматі +380XXXXXXXXX</p>
            </div>
          </div>
          <label class="flex items-start gap-2.5 text-xs text-muted mt-3">
            <input type="checkbox" name="consent" required class="mt-0.5 w-4 h-4 accent-accent shrink-0" />
            <span>Погоджуюсь на обробку персональних даних згідно з <a href="/privacy" class="text-accent underline">політикою</a></span>
          </label>
          <button type="submit" class="btn btn-primary w-full mt-4" data-quiz-submit>Отримати розрахунок</button>
          <p class="mt-3 text-sm text-accent-hover text-center hidden" data-quiz-error data-tg={site.telegram}></p>
        </form>

        <div class="hidden mt-4" data-quiz-thanks>
          <span class="inline-grid place-items-center w-14 h-14 rounded-full bg-success/15 text-success mx-auto">
            <Icon name="check-circle" size={28} />
          </span>
          <p class="mt-4 text-lg font-display font-semibold">Дякуємо! Зв’яжемось протягом години в робочий час.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';
  import { maxServicePrice } from '../data/pricing';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const intro = root.querySelector<HTMLElement>('[data-quiz-intro]')!;
    const steps = root.querySelector<HTMLElement>('[data-quiz-steps]')!;
    const resultBox = root.querySelector<HTMLElement>('[data-quiz-result]')!;
    const startBtn = root.querySelector<HTMLButtonElement>('[data-quiz-start]')!;
    const backBtn = root.querySelector<HTMLButtonElement>('[data-quiz-back]')!;
    const counter = root.querySelector<HTMLElement>('[data-quiz-counter]')!;
    const progress = root.querySelector<HTMLElement>('[data-quiz-progress]')!;
    const qCards = Array.from(root.querySelectorAll<HTMLElement>('[data-quiz-q]'));
    const total = qCards.length;

    const answers: Record<string, string> = {};
    let current = 0;

    function showStep(i: number) {
      qCards.forEach((c, idx) => c.classList.toggle('hidden', idx !== i));
      counter.textContent = `Питання ${i + 1} з ${total}`;
      progress.style.width = `${((i + 1) / total) * 100}%`;
      backBtn.hidden = i === 0;
    }

    startBtn.addEventListener('click', () => {
      intro.classList.add('hidden');
      steps.classList.remove('hidden');
      showStep(0);
    });

    backBtn.addEventListener('click', () => {
      if (current > 0) {
        current--;
        showStep(current);
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-quiz-opt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key')!;
        answers[key] = btn.getAttribute('data-value')!;
        if (current < total - 1) {
          current++;
          showStep(current);
        } else {
          finish();
        }
      });
    });

    // Крок надбавок: «нічого з переліченого» взаємовиключне з рештою
    const groundBoxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-ground]'));
    const groundNone = root.querySelector<HTMLInputElement>('[data-ground-none]');
    groundBoxes.forEach((box) => {
      box.addEventListener('change', () => {
        if (box.checked && groundNone) groundNone.checked = false;
      });
    });
    groundNone?.addEventListener('change', () => {
      if (groundNone.checked) groundBoxes.forEach((b) => (b.checked = false));
    });
    root.querySelector<HTMLButtonElement>('[data-quiz-next]')?.addEventListener('click', () => {
      if (current < total - 1) {
        current++;
        showStep(current);
      }
    });

    // Крок блокуючих умов: «нічого з переліченого» взаємовиключне з рештою,
    // включно з м'якими пунктами — вони на тому самому кроці.
    const blockerBoxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-blocker]'));
    const softBoxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-soft]'));
    const noneBox = root.querySelector<HTMLInputElement>('[data-blocker-none]');
    [...blockerBoxes, ...softBoxes].forEach((box) => {
      box.addEventListener('change', () => {
        if (box.checked && noneBox) noneBox.checked = false;
      });
    });
    noneBox?.addEventListener('change', () => {
      if (noneBox.checked) [...blockerBoxes, ...softBoxes].forEach((b) => (b.checked = false));
    });
    root.querySelector<HTMLButtonElement>('[data-quiz-finish]')?.addEventListener('click', finish);

    function num(n: number): string {
      return n.toLocaleString('uk-UA').replace(/,/g, ' ');
    }
    function fmt(n: number): string {
      return num(n) + ' ₴';
    }

    // Модель постанови КМУ № 616 (чинна з 1 вересня 2026): сума залежить
    // від напряму, а надбавки за категорію/регіон/робочі місця
    // підсумовуються й нараховуються на базову суму запиту.
    function computeEstimate() {
      const { track, jobs, region } = answers;
      const scaling = track === 'Масштабую діючу';

      const base = scaling ? { min: 500_000, max: 1_500_000 } : { min: 100_000, max: 300_000 };
      const cap = scaling ? 2_500_000 : 500_000;

      const bonuses: string[] = [];
      let pct = 0;

      // Підстави з мультивибору. Пункт 6 Порядку: за одночасної наявності
      // кількох умов відсотки підсумовуються, тож рахуємо кожну окремо.
      groundBoxes
        .filter((b) => b.checked)
        .forEach((b) => {
          const p = Number(b.dataset.pct || '0');
          pct += p;
          bonuses.push(`+${p}% ${b.dataset.short || ''}`);
        });

      // Прифронтовий регіон — та сама надбавка +30%, але питаємо окремо,
      // бо область потрібна нам і поза розрахунком.
      if (region === 'Харківська чи інша прифронтова') {
        pct += 30;
        bonuses.push('+30% прифронтовий регіон');
      }

      // Два нові робочі місця — окрема підстава на +20% (пункт 6).
      if (jobs === '2 і більше') {
        pct += 20;
        bonuses.push('+20% за два нові робочі місця');
      }

      // Надбавка рахується від базової суми, але не вище стелі напряму.
      const raw = Math.round((base.max * (100 + pct)) / 100);
      const withBonus = Math.min(raw, cap);

      return { scaling, base, cap, pct, bonuses, withBonus, capped: raw > cap };
    }

    let resultPayload = '';

    function finish() {
      steps.classList.add('hidden');
      resultBox.classList.remove('hidden');
      const iconWrap = resultBox.querySelector<HTMLElement>('[data-result-icon]')!;
      const title = resultBox.querySelector<HTMLElement>('[data-result-title]')!;
      const text = resultBox.querySelector<HTMLElement>('[data-result-text]')!;
      const note = resultBox.querySelector<HTMLElement>('[data-result-note]')!;
      const roi = resultBox.querySelector<HTMLElement>('[data-result-roi]')!;
      roi.hidden = true;
      roi.classList.add('hidden');

      // 1) Жорсткий відсів: блокуючі умови програми
      const hardBlockers = Array.from(root!.querySelectorAll<HTMLInputElement>('[data-blocker]'))
        .filter((b) => b.checked)
        .map((b) => b.getAttribute('data-label') || '');

      const soft = softBoxes.filter((b) => b.checked).map((b) => b.getAttribute('data-label') || '');

      // Без зобов'язання платити податки протягом строку проєкту грант
      // повертається (пункт 23), тож це не «мінус бали», а стоп.
      const blocked = answers['term'] === 'Не готовий(-а)';

      if (hardBlockers.length) {
        iconWrap.className = 'inline-grid place-items-center w-14 h-14 rounded-2xl mx-auto bg-accent/15 text-accent';
        iconWrap.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>';
        title.textContent = 'Це блокуючі умови — заявку відхилять автоматично';
        text.textContent =
          'Ви позначили: ' +
          hardBlockers.join('; ') +
          '. За чинними правилами це підстава для відмови ще на етапі перевірки в банку — до розгляду бізнес-плану. Ми не візьмемо з вас гроші за план, який завідомо не пройде. Напишіть нам: розберемо, чи можна усунути перешкоду і за який строк.';
        resultPayload = 'РЕЗУЛЬТАТ: блокуючі умови — ' + hardBlockers.join('; ');
      } else if (blocked) {
        iconWrap.className = 'inline-grid place-items-center w-14 h-14 rounded-2xl mx-auto bg-accent/15 text-accent';
        iconWrap.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
        title.textContent = 'Поки що не варто подаватись — ось у чому річ';
        text.textContent =
          'Найкоротший строк проєкту за програмою — два роки, і весь цей час треба працювати офіційно та платити податки за себе й найманих працівників. Якщо сплачені податки виявляться меншими за суму гранту, різницю доведеться повернути. Це не додаткова умова від нас, а механіка самої програми. Якщо готові переглянути строк — напишіть, порахуємо на безкоштовному аудиті.';
        resultPayload = 'РЕЗУЛЬТАТ: не готовий до зобов’язань за строком';
        note.hidden = true;
      } else {
        const est = computeEstimate();
        // Примітка про редакцію потрібна лише там, де ми назвали суму.
        note.hidden = false;
        note.classList.remove('hidden');
        iconWrap.className = 'inline-grid place-items-center w-14 h-14 rounded-2xl mx-auto bg-success/15 text-success';
        iconWrap.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';

        // Головне — сума, а не діапазон напряму: по неї людина і йшла
        // через сім кроків. Діапазон і склад надбавок — нижче, у поясненні.
        const trackName = est.scaling ? 'масштабування діючої справи' : 'старт власної справи';
        title.innerHTML = `Ваш орієнтир — <span class="text-accent">${fmt(est.withBonus)}</span>`;

        const parts: string[] = [
          `Напрям «${trackName}»: базовий діапазон ${num(est.base.min)} – ${fmt(est.base.max)}.`,
        ];
        if (est.bonuses.length) {
          parts.push(
            est.capped
              ? `Ваші надбавки: ${est.bonuses.join(', ')} — разом +${est.pct}%. Цього досить, щоб вийти на стелю напряму: ${fmt(est.cap)}.`
              : `Ваші надбавки: ${est.bonuses.join(', ')} — разом +${est.pct}%.`,
          );
        } else {
          parts.push(`Надбавок за вашими відповідями не набирається, стеля напряму — ${fmt(est.cap)}.`);
        }
        // Масштабування — лише для суб'єктів господарювання (пункт 6).
        if (est.scaling && answers['status'] === 'Фізособа — ще не зареєстрований') {
          parts.push(
            'Важливо: грант на масштабування дають лише зареєстрованим ФОП і юрособам. Незареєстрованій фізособі доступний напрям старту — це інший діапазон.',
          );
        }
        if (est.scaling && answers['jobs'] === '0') {
          parts.push('Увага: масштабування зобов’язує створити щонайменше одне нове робоче місце.');
        }
        if (soft.length) {
          parts.push(
            `Окремо перевіримо: ${soft.join('; ').toLowerCase()} — це критерії ділової репутації, за якими банк рахує бали на першому етапі. Автоматичної відмови це не дає, але саме тут заявки й зрізають.`,
          );
        }
        parts.push('Точну суму й реальні шанси визначимо на безкоштовному аудиті.');
        text.textContent = parts.join(' ');

        // Порівняння з мінімальною сумою напряму (не з надбавкою) — щоб
        // відсоток лишався чесним навіть у найгіршому для клієнта випадку.
        const roiPct = Math.ceil((maxServicePrice / est.base.min) * 100);
        roi.hidden = false;
        roi.classList.remove('hidden');
        roi.innerHTML = `<span class="font-display font-semibold text-ink">Вартість вкладень:</span> навіть повний супровід «під ключ» (до ${fmt(maxServicePrice)}) — це не більше ${roiPct}% від мінімальної суми вашого напряму (${fmt(est.base.min)}). Решта — ваші кошти на розвиток бізнесу.`;

        resultPayload = `РЕЗУЛЬТАТ: ${trackName}, ${num(est.base.min)} – ${fmt(est.base.max)}, надбавки +${est.pct}% → до ${fmt(est.withBonus)}`;
      }

      // Заповнюємо приховане поле основної форми (якщо є)
      const mainQuiz = document.getElementById('lead-quiz') as HTMLInputElement | null;
      if (mainQuiz) mainQuiz.value = JSON.stringify({ ...answers, result: resultPayload });

      trackEvent('quiz_complete');
    }

    // Форма захоплення в квізі
    const qform = resultBox.querySelector<HTMLFormElement>('[data-quiz-form]')!;
    const qphone = resultBox.querySelector<HTMLInputElement>('[data-quiz-phone]')!;
    const qphoneError = resultBox.querySelector<HTMLElement>('[data-quiz-phone-error]')!;
    const qError = resultBox.querySelector<HTMLElement>('[data-quiz-error]')!;
    qphone.addEventListener('input', () => {
      let d = qphone.value.replace(/\D/g, '');
      if (d.startsWith('380')) d = d.slice(3);
      d = d.replace(/^0+/, '');
      d = '380' + d;
      qphone.value = '+' + d.slice(0, 12);
    });
    qform.addEventListener('submit', async (e) => {
      e.preventDefault();
      if ((qform.elements.namedItem('company') as HTMLInputElement)?.value) return;
      qError.classList.add('hidden');
      if (!/^\+380\d{9}$/.test(qphone.value)) {
        qphoneError.classList.remove('hidden');
        qphone.setAttribute('aria-invalid', 'true');
        qphone.focus();
        return;
      }
      qphoneError.classList.add('hidden');
      qphone.removeAttribute('aria-invalid');
      const submit = qform.querySelector<HTMLButtonElement>('[data-quiz-submit]')!;
      submit.disabled = true;
      submit.textContent = 'Надсилаємо…';
      const data = Object.fromEntries(new FormData(qform).entries());
      const payload = { ...data, source: 'quiz', quiz: JSON.stringify({ ...answers, result: resultPayload }) };
      try {
        const res = await fetch('/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error();
        qform.classList.add('hidden');
        resultBox.querySelector('[data-quiz-thanks]')?.classList.remove('hidden');
        trackEvent('submit_form');
      } catch {
        submit.disabled = false;
        submit.textContent = 'Отримати розрахунок';
        const tg = qError.dataset.tg || '';
        qError.innerHTML = `Не вдалося надіслати автоматично. Напишіть нам у <a href="${tg}" target="_blank" rel="noopener" class="underline font-semibold">Telegram</a> або зателефонуйте.`;
        qError.classList.remove('hidden');
      }
    });
  }
</script>

---
// Повний перелік послуг і склад бізнес-плану. На головній лишились тарифи,
// а розгорнутий опис того, що входить у пакет, живе тут.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import Icon from '../components/Icon.astro';
import Services from '../components/Services.astro';
import PlanContents from '../components/PlanContents.astro';
import Pricing from '../components/Pricing.astro';
import LeadForm from '../components/LeadForm.astro';
---
<Layout
  title="Бізнес-план для гранту: послуги та ціни | ГрантПлан"
  description="Підготовка бізнес-плану для гранту по всій Україні: кошторис, фінансова модель, супровід подання та підготовка до співбесіди. Склад послуг, ціни й строки."
  path="/poslugy"
>
  <SiteHeader slot="header" />

  <section class="pt-28 md:pt-36 pb-10 md:pb-14 border-b border-border/70">
    <div class="container-site max-w-3xl">
      <a href="/" class="flex w-fit items-center gap-2 text-muted hover:text-ink text-sm py-2 -mt-2 mb-4">← На головну</a>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
        <Icon name="file-text" size={14} class="text-accent" /> Склад роботи
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl">Бізнес-план для гранту: послуги та ціни</h1>
      <p class="mt-5 text-muted text-lg leading-relaxed">
        Готуємо бізнес-плани для грантових заявок по всій Україні. Нижче — склад пакета за формою Дії, додаткові послуги, ціни та строки. Оберіть потрібний пакет і залиште заявку для уточнення деталей.
      </p>
    </div>
  </section>

  <PlanContents />
  <Services />
  <Pricing />
  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

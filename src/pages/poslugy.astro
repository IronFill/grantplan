---
// Повний перелік послуг і склад бізнес-плану. На головній лишились тарифи,
// а розгорнутий опис того, що входить у пакет, живе тут.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import Icon from '../components/Icon.astro';
import Services from '../components/Services.astro';
import PlanContents from '../components/PlanContents.astro';
import Pricing from '../components/Pricing.astro';
import LeadForm from '../components/LeadForm.astro';
import { blogPosts } from '../data/blog';
import { tiers } from '../data/pricing';
const preparationGuides = blogPosts.slice(0, 3);
const serviceQuestions = [
  { question: 'Скільки коштує підготовка бізнес-плану для гранту?', answer: `Пакет «Бізнес-план» — ${tiers.plan.label}, «Під ключ» — ${tiers.turnkey.label}. Перший аудит — безкоштовний, ${tiers.audit.term}. Остаточну ціну та обсяг роботи погоджуємо до початку підготовки.`, href: '#pricing', label: 'Порівняти пакети' },
  { question: 'За який час буде готовий бізнес-план?', answer: `Орієнтир для пакета «Бізнес-план» — ${tiers.plan.term}, для «Під ключ» — ${tiers.turnkey.term}. Для бізнес-плану відлік починається після отримання заповненої анкети та авансу. Якщо бракує вихідних даних або змінюється завдання, строк уточнюємо.`, href: '/umovy-spivpratsi-biznes-plan', label: 'Строки та умови співпраці' },
  { question: 'Чи можна замовити бізнес-план з іншого міста?', answer: 'Так, працюємо онлайн з клієнтами по всій Україні. На першій розмові уточнюємо вашу ідею, бюджет та потрібний склад роботи. Для початку не потрібно приїжджати до Харкова.', href: '#lead', label: 'Записатися на аудит' },
  { question: 'Що підготувати до першої консультації?', answer: 'Коротко опишіть ідею, клієнтів, основні покупки та ресурси, які вже маєте. Орієнтовних цифр достатньо для першої розмови. Якщо є попередня заявка або відмова — повідомте про це; не надсилайте паспорт, податковий номер чи банківські дані через форму.', href: '/blog/dokumenty-dlya-konsultatsii/', label: 'Перелік для підготовки до розмови' },
  { question: 'Чи входять правки та подання заявки у вартість?', answer: 'У пакет «Бізнес-план» входить до двох раундів правок у межах погодженого завдання; готові документи клієнт подає самостійно. У пакеті «Під ключ» передбачені також супровід подання та підготовка до співбесіди. Обсяг додаткових робіт погоджуємо окремо.', href: '/umovy-spivpratsi-pid-kluch', label: 'Умови пакета «Під ключ»' },
  { question: 'Чи гарантує готовий бізнес-план отримання гранту?', answer: 'Ні. Оплачується підготовка документів, а рішення щодо фінансування ухвалює уповноважений орган. На аудиті обговорюємо вихідні дані та ризики, щоб ви могли вирішити, чи продовжувати підготовку.', href: '/poslugy/#service-result', label: 'Що входить у результат роботи' },
];
---
<Layout
  title="Бізнес-план для гранту: послуги та ціни | ГрантПлан"
  description="Підготовка бізнес-плану для гранту по всій Україні: кошторис, фінансова модель, супровід подання та підготовка до співбесіди. Склад послуг, ціни й строки."
  path="/poslugy"
>
  <SiteHeader slot="header" />

  <section class="pt-28 md:pt-36 pb-10 md:pb-14 border-b border-border/70">
    <div class="container-site max-w-3xl">
      <a href="/" class="flex w-fit items-center gap-2 text-muted hover:text-ink text-sm py-2 -mt-2 mb-4">← На головну</a>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
        <Icon name="file-text" size={14} class="text-accent" /> Склад роботи
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl">Бізнес-план для гранту: послуги та ціни</h1>
      <p class="mt-5 text-muted text-lg leading-relaxed">
        Готуємо бізнес-плани для грантових заявок по всій Україні. Нижче — склад пакета за формою Дії, додаткові послуги, ціни та строки. Оберіть потрібний пакет і залиште заявку для уточнення деталей.
      </p>
      <nav aria-label="Швидкий перехід по послугах" class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a href="#service-result" class="inline-block py-2 text-accent underline underline-offset-4">Результат роботи</a>
        <a href="#pricing" class="inline-block py-2 text-accent underline underline-offset-4">Ціни та пакети</a>
        <a href="#service-questions" class="inline-block py-2 text-accent underline underline-offset-4">Питання перед замовленням</a>
        <a href="#lead" class="inline-block py-2 text-accent underline underline-offset-4" data-analytics="start_audit" data-analytics-location="service_navigation">Запис на аудит</a>
      </nav>
    </div>
  </section>


  <section class="py-12 md:py-16 border-b border-border/70" aria-labelledby="choose-service">
    <div class="container-site">
      <h2 id="choose-service" class="text-2xl sm:text-3xl">Як обрати послугу та підготуватися до розмови</h2>
      <div class="mt-6 grid md:grid-cols-2 gap-6">
        <article class="rounded-card border border-border bg-surface p-6">
          <h3 class="text-xl">Який пакет вам потрібен</h3>
          <ul class="mt-4 list-disc pl-5 space-y-3 text-muted">
            <li>Якщо ще обираєте ідею або не впевнені в програмі — почніть із безкоштовного аудиту.</li>
            <li>Якщо потрібні документи й узгоджені розрахунки — перегляньте пакет «Бізнес-план».</li>
            <li>Якщо потрібні також супровід подання та підготовка до співбесіди — перегляньте тариф «Під ключ».</li>
          </ul>
          <a href="#pricing" class="inline-block mt-4 py-2 text-accent underline underline-offset-4">Порівняти ціни та склад пакетів</a>
        </article>
        <article class="rounded-card border border-border bg-surface p-6">
          <h3 class="text-xl">Що повідомити на першому аудиті</h3>
          <ul class="mt-4 list-disc pl-5 space-y-3 text-muted">
            <li>Чим плануєте займатися, хто ваші клієнти та чи вже працює бізнес.</li>
            <li>Орієнтовний бюджет, основні покупки та обладнання або приміщення, які вже маєте.</li>
            <li>Що потрібно від нас і чи маєте попередню заявку або відмову.</li>
          </ul>
          <p class="mt-4 text-sm text-muted">Точні цифри можна уточнити пізніше. Через форму не надсилайте особисті документи.</p>
        </article>
      </div>
      <nav aria-label="Бізнес-плани за напрямами" class="mt-8">
        <h3 class="text-lg">Підготовка під вашу ситуацію</h3>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          <li><a href="/grant/agrobiznes" class="inline-block py-2 text-accent underline underline-offset-4">Агробізнес</a></li>
          <li><a href="/grant/veteranam" class="inline-block py-2 text-accent underline underline-offset-4">Ветерани та родини</a></li>
          <li><a href="/grant/molod" class="inline-block py-2 text-accent underline underline-offset-4">Перший бізнес для молоді</a></li>
          <li><a href="/grant/povtorny" class="inline-block py-2 text-accent underline underline-offset-4">Повторна заявка</a></li>
        </ul>
      </nav>
      <p class="mt-5 text-muted">Маєте відмову? <a href="/prychyny-vidmov" class="text-accent underline underline-offset-4">Перегляньте можливі причини</a> та обговоріть доопрацювання на аудиті. Перед поданням звіряємо <a href="/umovy-prohramy" class="text-accent underline underline-offset-4">умови програми з офіційними джерелами</a>.</p>
    </div>
  </section>

  <section class="py-12 md:py-16 border-b border-border/70" aria-labelledby="service-result">
    <div class="container-site max-w-3xl">
      <h2 id="service-result" class="text-2xl sm:text-3xl scroll-mt-24">Що ви отримаєте після підготовки бізнес-плану</h2>
      <p class="mt-4 text-muted">У пакеті «Бізнес-план» — опис проєкту у Word та розрахунки у XLS: кошторис, фінансова модель і пояснення вихідних припущень. Перед початком погоджуємо конкретний склад файлів і завдання. Презентація, супровід подання та репетиція співбесіди входять до пакета «Під ключ».</p>
      <ol class="mt-5 list-decimal pl-6 space-y-3 text-muted">
        <li>На аудиті уточнюємо ідею, наявні ресурси та відкриті питання.</li>
        <li>Погоджуємо обсяг роботи, ціну, строки та перелік вихідних даних.</li>
        <li>Готуємо документи, звіряємо цифри між файлами й опрацьовуємо погоджені правки.</li>
      </ol>
      <p class="mt-5 text-muted">Для прикладу структури та розрахунків перегляньте <a href="/case-sto" class="text-accent underline underline-offset-4">план майстерні</a>. Остаточне рішення щодо гранту приймає уповноважений орган; підготовка документів не гарантує фінансування.</p>
      <a href="#lead" data-analytics="start_audit" data-analytics-location="service_result" class="btn btn-primary mt-6">Обговорити свій бізнес-план на аудиті</a>
    </div>
  </section>
  <section class="py-12 md:py-16" aria-labelledby="service-guides">
    <div class="container-site">
      <h2 id="service-guides" class="text-2xl sm:text-3xl">Перед замовленням: ціна, підготовка та доопрацювання</h2>
      <div class="mt-6 grid md:grid-cols-3 gap-5">
        {preparationGuides.map(post => <article class="rounded-card border border-border bg-surface p-6"><h3 class="text-lg"><a data-analytics="open_guide" data-analytics-location="service_guides" data-analytics-guide={post.slug} href={`/blog/${post.slug}/`} class="text-accent underline underline-offset-4">{post.title}</a></h3><p class="mt-3 text-muted">{post.excerpt}</p></article>)}
      </div>
    </div>
  </section>

  <PlanContents />
  <Services />
  <Pricing />
  <section class="py-12 md:py-16 border-t border-border/70 scroll-mt-24" id="service-questions" aria-labelledby="service-questions-title">
    <div class="container-site max-w-3xl">
      <h2 id="service-questions-title" class="text-2xl sm:text-3xl">Питання перед замовленням бізнес-плану</h2>
      <p class="mt-4 text-muted">Коротко про вартість, строки та порядок роботи. Деталі конкретного проєкту погоджуємо на консультації.</p>
      <div class="mt-6 space-y-3">
        {serviceQuestions.map(item => (
          <details class="rounded-card border border-border bg-surface p-5">
            <summary class="cursor-pointer font-semibold leading-relaxed focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4">{item.question}</summary>
            <p class="mt-3 text-muted leading-relaxed">{item.answer}</p>
            <a href={item.href} class="inline-block mt-2 py-2 text-accent underline underline-offset-4" data-analytics={item.href === '#lead' ? 'start_audit' : undefined} data-analytics-location="service_questions">{item.label}</a>
          </details>
        ))}
      </div>
    </div>
  </section>
  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

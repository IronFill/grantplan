---
// Публічна довідка про офіційні умови програми «Власна справа».
// Принцип сторінки: ми НЕ підміняємо офіційне джерело, а стисло переказуємо
// його і поруч даємо прямі посилання на першоджерела (ДСЗ, Дія, КМУ),
// щоб людина могла перевірити кожен факт самостійно.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { getProgramStatus } from '../data/program';
import { site } from '../data/site';

const status = getProgramStatus();

// Дата останньої звірки з офіційними джерелами. Оновлювати руками
// разом зі змістом — вона показана користувачеві у шапці сторінки.
const updated = '11 вересня 2026';

// --- Суми за чинними правилами (редакція, що діє з 1 січня 2026) ---
const sums = [
  {
    label: 'Без створення робочих місць',
    base: 'до 100 000 ₴',
    note: 'За умови реєстрації ФОП',
    front: null,
  },
  {
    label: '1 робоче місце',
    base: 'до 200 000 ₴',
    note: 'Офіційне працевлаштування на повний день',
    front: 'Прифронтові області — більше',
  },
  {
    label: 'Від 2 робочих місць',
    base: 'до 350 000 ₴',
    note: 'Два і більше офіційних робочих місця',
    front: 'Харківщина — до 500 000 ₴',
  },
  {
    label: 'Молодь 18–25 років',
    base: 'до 200 000 ₴',
    note: 'Окремі умови щодо робочих місць',
    front: null,
  },
  {
    label: 'Ветерани та їхні родини',
    base: 'до 1 000 000 ₴',
    note: 'Окремий ветеранський напрям',
    front: null,
  },
  {
    label: 'Повторний грант',
    base: 'доступний з 2026 року',
    note: 'За умови виконання зобов’язань за попереднім',
    front: null,
  },
];

// Дев'ять прифронтових областей + Славутицька МТГ — надбавка +30%.
const frontRegions = [
  'Дніпропетровська',
  'Донецька',
  'Запорізька',
  'Миколаївська',
  'Одеська',
  'Сумська',
  'Харківська',
  'Херсонська',
  'Чернігівська',
];

// --- Система бонусів до бази (постанова КМУ № 616, надбавки підсумовуються) ---
const bonuses = [
  {
    pct: '+5%',
    title: 'Молодь 18–25 років',
    text: 'Включно — незалежно від напряму.',
  },
  {
    pct: '+20%',
    title: 'Будь-яка з умов',
    text: 'Суб’єкти ветеранського підприємництва; платники ПДВ; власники чинного патенту на винахід/корисну модель, пов’язаного з проєктом; ВПО з досвідом підприємництва понад 6 місяців або релоковані підприємства; або зобов’язання створити 2 нові робочі місця.',
  },
  {
    pct: '+30%',
    title: 'Будь-яка з умов',
    text: `Реєстрація й діяльність у прифронтових областях (${frontRegions.join(', ')}) та Славутицькій МТГ Київської області; або відновлення знищених чи пошкоджених виробничих потужностей.`,
  },
  {
    pct: '+50%',
    title: 'Пріоритетні сектори економіки',
    text: 'Належність визначає Державний центр зайнятості за КВЕД у заяві й бізнес-плані. Повний перелік із 16 категорій — на сторінці новини про реформу.',
  },

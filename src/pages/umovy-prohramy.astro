---
// Публічна довідка про офіційні умови програми «Власна справа».
// Принцип сторінки: ми НЕ підміняємо офіційне джерело, а стисло переказуємо
// його і поруч даємо прямі посилання на першоджерела (ДСЗ, Дія, КМУ),
// щоб людина могла перевірити кожен факт самостійно.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';

// Дата останньої звірки з офіційними джерелами. Оновлювати руками
// разом зі змістом — вона показана користувачеві у шапці сторінки.

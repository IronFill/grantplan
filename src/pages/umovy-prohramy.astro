    meta: '99 балів і більше',
  },
  {
    n: '03',
    icon: 'mic',
    title: 'Співбесіда в центрі зайнятості',
    text:
      'Регіональний центр зайнятості оцінює співбесіду до 50 балів. Молодь 18–25 років із сертифікатом менторської програми співбесіду не проходить — вона зараховується як пройдена успішно.',
    meta: 'До 50 балів',
  },
  {
    n: '04',
    icon: 'badge-check',
    title: 'Рішення Державного центру зайнятості',
    text:
      'До розгляду допускають заяви із сумарним балом 130 і більше. Рішення ухвалюють протягом 20 календарних днів після кінцевого строку подання заяв за відповідний період — дати на кожен період встановлює Мінекономіки.',
    meta: '20 календарних днів',
  },
  {
    n: '05',
    icon: 'handshake',
    title: 'Договір і рахунок',
    text:
      'Фізична особа має 20 календарних днів, щоб зареєструвати ФОП або юрособу й підписати договір; юрособа, що вже зареєстрована, — 10 робочих днів. Пропуск строку означає скасування рішення про надання гранту.',
    meta: '20 днів / 10 роб. днів',
  },
];

// --- Бальна система (постанова КМУ № 616) ---
const scoring = [
  { label: 'Перевірка банку — потрібно', value: '99 балів і більше' },
  { label: 'Співбесіда в центрі зайнятості', value: 'до 50 балів' },
  { label: 'Підсумково для розгляду', value: '130 балів і більше' },
  { label: 'Коефіцієнт для ветеранів*', value: '×1,25' },
];

// --- Обов'язки після отримання ---
const duties = [
  {
    icon: 'target',
    t: 'Цільове використання коштів',
    d: 'Витрачати грант можна лише на позиції, зафіксовані в затвердженому кошторисі. Кожна покупка підтверджується документами.',
  },
  {
    icon: 'users',
    t: 'Створення та збереження робочих місць',
    d: 'Для масштабування — мінімум 1 нове робоче місце; якщо взяли бонус за 2 місця — обов’язок відповідний. Створити потрібно протягом 3 місяців із дня зарахування коштів і зберегти 18, 24 або 54 місяці — залежно від обраного строку проєкту (2, 3 або 5 років).',
  },
  {
    icon: 'coins',
    t: 'Сплата податків',
    d: 'Сплачені податки (ПДФО, ЄСВ, єдиний податок, військовий збір) — основне підтвердження того, що бізнес реально працює, а грант використано за призначенням.',
  },
  {
    icon: 'file-text',
    t: 'Звітність перед центром зайнятості',
    d: 'Отримувач звітує про використання коштів і виконання зобов’язань у порядку та строки, визначені договором.',
  },
  {
    icon: 'shield-alert',
    t: 'Повернення коштів у разі невиконання',
    d: 'Невиконання умов договору — підстава для повернення гранту. Передбачено призупинення зобов’язань у разі мобілізації або полону отримувача.',
  },
];

// --- Підстави для відмови ---
const refusals = [
  'Невідповідність заявника вимогам програми',
  'Менше ніж 99 балів за перевірку ділової репутації',
  'Підсумковий бал нижче 130',
  'Непрозорі або сумнівні очікувані результати бізнес-плану',
  'Негативна ділова репутація, зокрема за даними з відкритих джерел',
  'Заявник уже отримував грант за програмою',
  'Відмова від участі у співбесіді',
];

// --- Що не можна фінансувати ---
const bans = ['Виробництво та реалізація зброї', 'Алкогольні напої', 'Тютюнові вироби'];

// --- Офіційні джерела ---
const sources = [
  {
    t: 'Державна служба зайнятості — мікрогрант «Власна справа»',
    d: 'Основна офіційна сторінка програми: умови, роз’яснення, контакти регіональних центрів.',
    href: 'https://www.dcz.gov.ua/people/micro',
    host: 'dcz.gov.ua',
  },
  {
    t: 'Дія — послуга «Грант на власну справу»',
    d: 'Портал, через який подається заявка. Тут же — актуальний перелік документів.',
    href: 'https://diia.gov.ua/services/grant-na-vlasnu-spravu',
    host: 'diia.gov.ua',
  },
  {
    t: 'Гід онлайн-послуг Дія',
    d: 'Покроковий опис послуги надання мікрогранту на створення або розвиток власного бізнесу.',
    href: 'https://guide.diia.gov.ua/',
    host: 'guide.diia.gov.ua',
  },
  {
    t: 'Постанова КМУ № 738 «Деякі питання надання грантів бізнесу»',
    d: 'Базовий нормативний акт програми, у 2026 році доповнений постановою № 616 (нижче). Саме чинна на дату подання редакція є визначальною.',
    href: 'https://www.kmu.gov.ua/npas/deyaki-pitannya-nadannya-grantiv-biznesu-738-210622',
    host: 'kmu.gov.ua',
  },
  {
    t: 'Постанова КМУ від 15.05.2026 № 616 (документ 616-2026-п)',
    d: 'Зміни, якими затверджено Порядок надання грантів на започаткування або масштабування власної справи — суми, бонуси й процедура з цієї сторінки викладені саме за ним.',
    href: 'https://zakon.rada.gov.ua/laws/show/616-2026-п',
    host: 'zakon.rada.gov.ua',
  },
  {
    t: 'Дія.Бізнес — новини грантових програм',
    d: 'Оперативні повідомлення про зміни умов програми «Власна справа».',
    href: 'https://business.diia.gov.ua/',
    host: 'business.diia.gov.ua',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Умови програми «Власна справа» у 2026 році — офіційні джерела',
  datePublished: '2026-07-26',
  dateModified: '2026-09-11',
  image: new URL('/og-default.png', site.url).href,
  author: { '@type': 'Organization', name: 'ГрантПлан' },
  publisher: {
    '@type': 'Organization',
    name: 'ГрантПлан',
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site.url).href, width: 180, height: 180 },
  },
  about: 'Мікрогрант «Власна справа» від Державної служби зайнятості',

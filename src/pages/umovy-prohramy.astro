// Дев'ять областей із підвищеним лімітом (прифронтові).
const frontRegions = [
  'Харківська',
  'Донецька',
  'Дніпропетровська',
  'Запорізька',
  'Миколаївська',
  'Херсонська',
  'Чернігівська',
  'Сумська',
  'Одеська',

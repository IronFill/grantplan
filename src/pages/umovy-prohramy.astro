    meta: 'Регіональний центр зайнятості',
  },
  {
    n: '04',
    icon: 'badge-check',
    title: 'Рішення Державного центру зайнятості',
    text:
      'Усі висновки, бали та документи надходять до Державного центру зайнятості, який ухвалює остаточне рішення про надання або відмову в мікрогранті.',
    meta: '10 робочих днів',
  },
  {
    n: '05',
    icon: 'handshake',
    title: 'Договір і рахунок',

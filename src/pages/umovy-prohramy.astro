const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Умови програми «Власна справа» у 2026 році — офіційні джерела',
  datePublished: '2026-07-26',
  author: { '@type': 'Organization', name: 'ГрантПлан' },
  about: 'Мікрогрант «Власна справа» від Державної служби зайнятості',
};
---
<Layout
  title="Умови гранту «Власна справа» 2026: суми і вимоги | ГрантПлан"
  description="Чесний переказ офіційних умов мікрогранту: суми до 500 000 ₴, вимоги, бальна система, підстави для відмови. З посиланнями на dcz.gov.ua і Дію."
  path="/umovy-prohramy"
  schema={[schema]}
>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <section class="relative pt-28 md:pt-36 pb-12 md:pb-16 border-b border-border/70">
    <div class="container-site">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-2 text-muted hover:text-ink text-sm mb-6">← На головну</a>
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
          <Icon name="landmark" size={14} class="text-accent" /> Довідка за офіційними джерелами
        </span>
        <h1 class="mt-4 text-3xl sm:text-5xl">
          Умови гранту <span class="text-accent">«Власна справа»</span> у 2026 році
        </h1>
        <p class="mt-5 text-muted text-lg leading-relaxed">
          Ми зібрали в одному місці те, що зараз написано на сторінках Державної служби зайнятості, Дії та в постанові Кабінету Міністрів — простою мовою і без «продажного» тону. Біля кожного розділу є посилання на першоджерело, щоб ви могли перевірити будь-яку цифру самостійно.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
          <span class="inline-flex items-center gap-2">
            <Icon name="calendar-clock" size={16} class="text-accent" /> Звірено: {updated}
          </span>
          <a
            href="https://www.dcz.gov.ua/people/micro"
            target="_blank"
            rel="noopener nofollow"
            class="inline-flex items-center gap-2 text-accent hover:underline"
          >
            <Icon name="external-link" size={16} /> Оригінал на dcz.gov.ua
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Головне попередження: програма оновлюється -->
  <section class="py-10 md:py-14">
    <div class="container-site">
      <div class="reveal rounded-card-lg border border-accent/70 bg-raised p-6 md:p-7">
        <div class="flex items-start gap-4">
          <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 text-accent shrink-0">
            <Icon name="alert-triangle" size={22} />
          </span>
          <div class="max-w-2xl">
            <h2 class="text-xl font-display font-semibold">Найважливіше на липень 2026: програма змінює модель</h2>
            <p class="mt-3 text-muted leading-relaxed">
              За повідомленнями Мінекономіки та Уряду, чинні правила діють до <span class="text-ink font-medium">1 серпня 2026</span>, а з <span class="text-ink font-medium">1 вересня 2026</span> запрацює оновлена модель: замість фіксованих сум — гнучкі діапазони, нова система бонусів, спрощені умови щодо робочих місць і окремий напрям на масштабування вже діючого бізнесу.
            </p>
            <div class="mt-5 grid sm:grid-cols-2 gap-4">
              <div class="rounded-card-sm border border-border bg-surface p-4">
                <div class="text-sm text-muted">Старт бізнесу</div>
                <div class="mt-1 font-display font-extrabold text-lg text-accent">100 000 – 300 000 ₴</div>
                <div class="mt-1 text-sm text-success">з можливістю збільшення до 500 000 ₴</div>
              </div>
              <div class="rounded-card-sm border border-border bg-surface p-4">
                <div class="text-sm text-muted">Масштабування</div>
                <div class="mt-1 font-display font-extrabold text-lg text-accent">500 000 – 1 500 000 ₴</div>
                <div class="mt-1 text-sm text-success">з можливістю збільшення до 2 500 000 ₴</div>
              </div>
            </div>
            <p class="mt-4 text-sm text-muted">
              Розмір фінансування залежатиме від кількості створених робочих місць, регіону, галузі та категорії заявника. Точні параметри визначає редакція порядку, чинна на дату подання, — саме її ми звіряємо перед кожною заявкою.
            </p>
            <a href="/blog/onovlennya-vlasna-sprava-veresen-2026" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:gap-2 transition-all">
              Детальніше про перехід на нову модель <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Суми -->
  <section class="py-12 md:py-16 border-t border-border/70 bg-surface/30">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Ліміти фінансування</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">Скільки дають за чинними правилами</h2>
        <p class="mt-3 text-muted">
          Суми, що діють у редакції з 1 січня 2026 року. Сума прив’язана не до ідеї, а до кількості офіційних робочих місць, які ви зобов’язуєтесь створити.
        </p>
      </div>

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sums.map((s) => (
          <div class="reveal rounded-card bg-surface border border-border p-5 flex flex-col">
            <div class="flex items-center gap-2.5">
              <Icon name="wallet" size={20} class="text-accent shrink-0" />
              <span class="font-medium">{s.label}</span>
            </div>
            <div class="mt-3 font-display font-extrabold text-xl text-accent">{s.base}</div>
            {s.front && <div class="mt-1 text-sm text-success">{s.front}</div>}
            <p class="mt-3 text-sm text-muted leading-relaxed">{s.note}</p>
          </div>
        ))}
      </div>

      <div class="reveal mt-6 rounded-card border border-border bg-raised p-5 md:p-6">
        <div class="flex items-start gap-3">
          <Icon name="map-pin" size={20} class="text-accent shrink-0 mt-0.5" />
          <div>
            <div class="font-medium">Підвищений ліміт для прифронтових областей</div>
            <p class="mt-2 text-sm text-muted leading-relaxed">
              Підприємці з дев’яти областей можуть претендувати на суму до 500 000 ₴: {frontRegions.join(', ')}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Процедура -->
  <section class="py-12 md:py-16 border-t border-border/70">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Процедура подання</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">Як проходить розгляд заявки</h2>
        <p class="mt-3 text-muted">
          Офіційна процедура складається з п’яти етапів. Державний центр зайнятості розглядає заявку протягом 10 робочих днів після встановленого строку подання.
        </p>
      </div>

      <ol class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-4 items-stretch">
        {steps.map((s, i) => (
          <li class="reveal card-hover flex flex-col rounded-card bg-surface border border-border p-6" style={`transition-delay:${i * 60}ms`}>
            <div class="flex items-center justify-between">
              <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 text-accent">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="font-display font-extrabold text-2xl text-border">{s.n}</span>
            </div>
            <h3 class="mt-5 text-lg font-display font-semibold">{s.title}</h3>
            <p class="mt-2.5 text-sm text-muted leading-relaxed flex-1">{s.text}</p>
            <div class="mt-5 pt-4 border-t border-border/70 flex items-center gap-2 text-xs font-medium text-accent">
              <Icon name="clock" size={14} /> {s.meta}
            </div>
          </li>
        ))}
      </ol>

      <p class="reveal mt-6 text-sm text-muted max-w-3xl">
        Якщо бізнес-план повертають на доопрацювання, виправлений документ потрібно подати протягом 15 днів із моменту отримання повідомлення. Типові питання співбесіди — на сторінці
        <a href="/spivbesida" class="text-accent hover:underline">«Питання на співбесіді»</a>.
      </p>
    </div>
  </section>

  <!-- Бали -->
  <section class="py-12 md:py-16 border-t border-border/70 bg-surface/30">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Бальна система</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">Як рахують бали</h2>
        <p class="mt-3 text-muted">
          Рішення ухвалюється не «на око»: заявка отримує підсумковий бал, і саме він визначає результат.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
        {scoring.map((s) => (
          <div class="reveal rounded-card bg-surface border border-border p-5 text-center lg:text-left">
            <div class="font-display font-extrabold text-2xl text-accent tabular-nums">{s.value}</div>
            <div class="mt-2 text-sm text-muted leading-snug">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="reveal mt-6 rounded-card border border-border bg-raised p-5 md:p-6 max-w-3xl">
        <p class="text-sm text-muted leading-relaxed">
          <span class="text-ink font-medium">Що це означає на практиці.</span> Найбільша вага — у перевірки ділової репутації, і саме там заявку «зрізають» ще до співбесіди: результат 98 балів або менше на цьому етапі є самостійною підставою для відмови. Тому чистота кредитної історії, відсутність боргів і прозорість заявника важать не менше, ніж сама ідея.
        </p>
      </div>
    </div>
  </section>

  <!-- Обов'язки -->
  <section class="py-12 md:py-16 border-t border-border/70">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Договірні зобов’язання</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">Що ви зобов’язані після отримання коштів</h2>
        <p class="mt-3 text-muted">
          Грант — безповоротний лише за умови виконання договору. Це головне, що варто зрозуміти до подання заявки.
        </p>
      </div>

      <div class="mt-8 grid md:grid-cols-2 gap-4">
        {duties.map((d) => (
          <div class="reveal rounded-card bg-surface border border-border p-6">
            <div class="flex items-start gap-3">
              <span class="inline-grid place-items-center w-10 h-10 rounded-xl bg-accent/10 text-accent shrink-0">
                <Icon name={d.icon} size={20} />
              </span>
              <div>
                <div class="font-display font-semibold">{d.t}</div>
                <p class="mt-2 text-sm text-muted leading-relaxed">{d.d}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="reveal mt-6 text-sm text-muted max-w-3xl">
        Детальний розбір строків, звітності та що станеться, якщо закрити бізнес раніше або потрапити під мобілізацію — на сторінці
        <a href="/pislya-hrantu" class="text-accent hover:underline">«Що буде після гранту»</a>.
      </p>
    </div>
  </section>

  <!-- Відмови + заборони -->
  <section class="py-12 md:py-16 border-t border-border/70 bg-surface/30">
    <div class="container-site grid lg:grid-cols-2 gap-6 lg:gap-8">
      <div class="reveal rounded-card-lg bg-surface border border-border p-6 md:p-7">
        <div class="flex items-center gap-3">
          <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 text-accent shrink-0">
            <Icon name="shield-alert" size={22} />
          </span>
          <h2 class="text-xl font-display font-semibold">Підстави для відмови</h2>
        </div>
        <ul class="mt-5 space-y-3">
          {refusals.map((r) => (
            <li class="flex items-start gap-3 text-sm text-muted leading-relaxed">
              <Icon name="x" size={16} class="text-accent shrink-0 mt-1" />
              <span>{r}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 pt-5 border-t border-border/70 text-sm text-muted">
          Детальний розбір кожної причини з прикладами — у нашій статті
          <a href="/prychyny-vidmov" class="text-accent hover:underline">«Чому відмовляють у гранті»</a>.
        </p>
      </div>

      <div class="reveal rounded-card-lg bg-surface border border-border p-6 md:p-7">
        <div class="flex items-center gap-3">
          <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 text-accent shrink-0">
            <Icon name="ban" size={22} />
          </span>
          <h2 class="text-xl font-display font-semibold">Що не можна фінансувати</h2>
        </div>
        <ul class="mt-5 space-y-3">
          {bans.map((b) => (
            <li class="flex items-start gap-3 text-sm text-muted leading-relaxed">
              <Icon name="x" size={16} class="text-accent shrink-0 mt-1" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 pt-5 border-t border-border/70 text-sm text-muted leading-relaxed">
          Перелік обмежень ширший за ці три позиції й залежить від редакції порядку та обраних КВЕДів. Непрофільні та заборонені види діяльності ми відсікаємо ще на безкоштовному аудиті — до того, як ви витратите час на підготовку документів.
        </p>
      </div>
    </div>
  </section>

  <!-- Офіційні джерела -->
  <section class="py-12 md:py-16 border-t border-border/70">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <span class="text-accent font-display font-semibold text-sm uppercase tracking-wide">Перевірте самі</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">Офіційні джерела</h2>
        <p class="mt-3 text-muted">
          Ми — приватна консалтингова практика, а не державна установа. Усе, що написано вище, — переказ відкритої інформації. Якщо між цією сторінкою та офіційним джерелом виникне розбіжність, чинним є офіційне джерело.
        </p>
      </div>

      <div class="mt-8 grid md:grid-cols-2 gap-4">
        {sources.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener nofollow"
            class="reveal card-hover group flex flex-col rounded-card bg-surface border border-border p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="font-display font-semibold group-hover:text-accent transition-colors">{s.t}</span>
              <Icon name="external-link" size={18} class="text-muted shrink-0 mt-1" />
            </div>
            <p class="mt-2.5 text-sm text-muted leading-relaxed flex-1">{s.d}</p>
            <span class="mt-4 pt-3 border-t border-border/70 text-xs font-medium text-accent">{s.host}</span>
          </a>
        ))}
      </div>

      <div class="reveal mt-8 rounded-card border border-border bg-raised p-6 max-w-3xl">
        <div class="flex items-start gap-3">
          <Icon name="shield-check" size={20} class="text-success shrink-0 mt-0.5" />
          <p class="text-sm text-muted leading-relaxed">
            <span class="text-ink font-medium">Наша позиція.</span> Рішення про надання гранту ухвалює виключно Державна служба зайнятості. Жоден консультант не може його гарантувати чи прискорити — і той, хто обіцяє протилежне, вводить вас в оману. Ми відповідаємо лише за те, що справді від нас залежить: якість бізнес-плану, обґрунтованість кошторису і вашу готовність до співбесіди.
          </p>
        </div>
      </div>
    </div>
  </section>

  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

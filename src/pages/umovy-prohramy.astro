    host: 'kmu.gov.ua',
  },
  {
    t: 'Дія.Бізнес — новини грантових програм',
    d: 'Оперативні повідомлення про зміни умов програми «Власна справа».',
    href: 'https://business.diia.gov.ua/',
    host: 'business.diia.gov.ua',
  },

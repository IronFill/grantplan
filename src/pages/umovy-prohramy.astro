// --- Процедура подання: офіційні етапи і строки (постанова КМУ № 616) ---
const steps = [
  {
    n: '01',
    icon: 'file-text',
    title: 'Заявка та бізнес-план',
    text:
      'Подання через портал Дія: розділ «єРобота» → «Власна справа». Авторизація через BankID або кваліфікований електронний підпис. До заявки додається бізнес-план за формою Служби зайнятості з кошторисом — без нього заяву не розглядають.',
    meta: 'Портал Дія',
  },
  {
    n: '02',
    icon: 'landmark',
    title: 'Перевірка в уповноваженому банку',
    text:

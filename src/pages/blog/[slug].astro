---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MobileCta from '../../components/MobileCta.astro';
import LeadForm from '../../components/LeadForm.astro';
import ChecklistCta from '../../components/ChecklistCta.astro';
import Icon from '../../components/Icon.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import PracticalGuides from '../../components/PracticalGuides.astro';
import { blogPosts } from '../../data/blog';
import { site } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const localLeadHref = (href: string) => ['/#lead', '/poslugy/#lead'].includes(href) ? '#lead' : href;

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: p.title,
  description: p.metaDescription,
  datePublished: p.date,
  dateModified: p.updatedDate ?? p.date,
  image: new URL('/og-default.png', site.url).href,
  author: { '@type': 'Organization', name: 'ГрантПлан' },
  publisher: {
    '@type': 'Organization',
    name: 'ГрантПлан',
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site.url).href, width: 180, height: 180 },
  },
  mainEntityOfPage: new URL(`/blog/${p.slug}/`, site.url).href,
};
---
<Layout title={p.metaTitle} description={p.metaDescription} path={`/blog/${p.slug}`} schema={[schema]}>
  <SiteHeader slot="header" leadHref="#lead" />

  {/* Hero */}
  <section class="relative pt-28 md:pt-36 pb-8 md:pb-12 border-b border-border/70">
    <div class="container-site container-text">
      <nav aria-label="Шлях до статті" class="text-sm text-muted mb-4">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li><a href="/" class="inline-block py-2 hover:text-ink">ГрантПлан</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog/" class="inline-block py-2 hover:text-ink">Блог</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="min-w-0">{p.title}</li>
        </ol>
      </nav>
      <span class={'inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ' + (p.category === 'news' ? 'bg-accent/10 text-accent' : 'bg-success/10 text-success')}>
        {p.categoryLabel}
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-sm text-muted">
        {fmtDate(p.date)} · {p.readMin} хв читання
        {p.updatedDate && p.updatedDate !== p.date && <> · оновлено {fmtDate(p.updatedDate)}</>}
      </p>

      {p.outdated && (
        <div class="mt-6 rounded-card border border-accent/70 bg-raised p-5">
          <div class="flex items-start gap-3">
            <Icon name="alert-triangle" size={20} class="text-accent shrink-0 mt-0.5" />
            <div>
              <p class="text-sm leading-relaxed">
                <span class="font-medium">Новина застаріла. </span>
                <span class="text-muted">{p.outdated.note}</span>
              </p>
              <a href={p.outdated.href} class="mt-3 py-1 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:gap-2 transition-all">
                {p.outdated.label} <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  {/* Тіло статті */}
  <section class="pt-10 pb-14 md:py-16">
    <div class="container-site lg:grid lg:grid-cols-[minmax(0,1fr)_260px] gap-10 lg:gap-16 items-start">
      <div>
      <div class="reveal space-y-5 text-[1.05rem] leading-relaxed max-w-3xl">
        {p.body.map((block, i) => {
          if (block.type === 'h2') return <h2 id={`rozdil-${i}`} class="!mt-10 scroll-mt-24 text-2xl font-display font-semibold">{block.text}</h2>;
          if (block.type === 'p') return <p class="text-muted">{block.text}</p>;
          if (block.type === 'ul') return (
            <ul class="space-y-2.5">
              {block.items.map((item) => (
                <li class="flex items-start gap-3 text-muted">
                  <Icon name="check" size={18} class="text-success shrink-0 mt-1" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          );
          if (block.type === 'links') return (
            <nav aria-label="Корисні посилання до статті" class="rounded-card border border-border p-5">
              <ul class="space-y-3">
                {block.items.map(item => <li><a href={localLeadHref(item.href)} class="inline-block py-2 text-accent underline underline-offset-4" {...(item.href.startsWith('https://') ? { target: '_blank', rel: 'noopener' } : {})}>{item.label}</a></li>)}
              </ul>
            </nav>
          );
          if (block.type === 'download') return (
            <div class="rounded-card border border-accent/50 bg-raised p-5 sm:p-6">
              <h2 class="text-xl font-display font-semibold">{block.title ?? 'Анкета для першої розмови'}</h2>
              <p class="mt-3 text-muted">{block.text}</p>
              <a href={block.href} download class="btn btn-primary mt-5 w-full sm:w-auto text-center" data-analytics={block.analytics ?? 'download_audit_worksheet'} data-analytics-location="article" data-analytics-guide={p.slug}>
                <Icon name="file-text" size={18} class="shrink-0" /> {block.label}
              </a>
              <p class="mt-3 text-sm text-muted">Це підготовка до консультації, а не форма заявки на грант. Для запису достатньо <a href="#lead" class="text-accent underline underline-offset-4">залишити контакт і короткий опис ідеї</a>.</p>
            </div>
          );
          if (block.type === 'callout') return (
            <div class="rounded-card border border-accent/70 bg-raised p-5 text-muted">
              <span class="text-ink font-medium">Чесно: </span>{block.text}
            </div>
          );
          if (block.type === 'table') return (
            // На телефоні рядки стають картками: третя колонка («Що входить») не ховається за горизонтальним скролом.
            <div class="rounded-card border border-border sm:overflow-x-auto">
              <table class="block sm:table w-full text-left border-collapse sm:min-w-[480px] text-[0.95rem]">
                <thead class="hidden sm:table-header-group">
                  <tr class="bg-surface text-sm text-muted">
                    {block.headers.map((h) => <th class="py-3 px-4 font-medium">{h}</th>)}
                  </tr>
                </thead>
                <tbody class="block sm:table-row-group">
                  {block.rows.map((row) => (
                    <tr class="block sm:table-row border-t border-border first:border-t-0 sm:first:border-t">
                      {row.map((cell, ci) => (
                        <td class={'block sm:table-cell px-4 py-1.5 sm:py-3 first:pt-3 last:pb-3' + (ci === 0 ? ' text-ink font-medium' : ' text-muted')}>
                          {ci > 0 && <span class="sm:hidden block text-xs text-muted/90 font-medium">{block.headers[ci]}</span>}
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
          return null;
        })}
      </div>

      {p.relatedHref && (
        <a href={localLeadHref(p.relatedHref)} class="reveal mt-8 flex items-center justify-between gap-3 rounded-card bg-surface border border-border p-5 hover:border-accent transition-colors">
          <span>
            <span class="block text-xs text-muted">Дивіться також</span>
            <span class="font-medium">{p.relatedLabel}</span>
          </span>
          <Icon name="arrow-right" size={18} class="text-accent shrink-0" />
        </a>
      )}
      </div>

      <ArticleAside
        items={p.body
          .map((b, i) => (b.type === 'h2' ? { href: `#rozdil-${i}`, label: b.text } : null))
          .filter((x): x is { href: string; label: string } => x !== null)}
        ctaTitle="Питання по вашій ситуації?"
        ctaHref="#lead"
        ctaText="Стаття загальна, ваш випадок — ні. На безкоштовному аудиті розберемо конкретно вашу ідею."
      />
    </div>
  </section>

  <section class="container-site pb-10"><PracticalGuides excludeSlug={p.slug} title="Читайте також: підготовка бізнес-плану" level={2} /></section>

  <ChecklistCta />
  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta leadHref="#lead" />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MobileCta from '../../components/MobileCta.astro';
import LeadForm from '../../components/LeadForm.astro';
import ChecklistCta from '../../components/ChecklistCta.astro';
import Icon from '../../components/Icon.astro';
import { sortedBlogPosts } from '../../data/blog';

const posts = sortedBlogPosts();

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout
  title="Блог: новини програми «Власна справа» та поради з бізнес-плану | ГрантПлан"
  description="Новини про зміни в програмі «Власна справа» з 1 вересня 2026 та практичні поради з підготовки бізнес-плану — КВЕД, кошторис, фінансова модель."
  path="/blog"
>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <section class="relative pt-28 md:pt-36 pb-12 md:pb-16 border-b border-border/70">
    <div class="container-site max-w-3xl">
      <a href="/" class="inline-flex items-center gap-2 text-muted hover:text-ink text-sm mb-6">← На головну</a>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
        <Icon name="file-text" size={14} class="text-accent" /> Блог · новини та поради
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl">Новини програми і практичні поради</h1>
      <p class="mt-5 text-muted text-lg">
        Стежимо за змінами в «Власній справі» та ділимося тим, що реально впливає на бали заявки — без води і без переказу того, що й так є на офіційних сайтах.
      </p>
    </div>
  </section>

  <!-- Список постів -->
  <section class="py-14 md:py-20">
    <div class="container-site max-w-3xl">
      <div class="grid gap-4">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="reveal card-hover block rounded-[16px] bg-surface border border-border p-6 md:p-7">
            <div class="flex items-center gap-3 text-xs">
              <span class={'inline-flex items-center rounded-full px-2.5 py-1 font-medium ' + (p.category === 'news' ? 'bg-accent/10 text-accent' : 'bg-success/10 text-success')}>
                {p.categoryLabel}
              </span>
              <span class="text-muted">{fmtDate(p.date)} · {p.readMin} хв читання</span>
            </div>
            <h2 class="mt-3 text-xl font-display font-semibold">{p.title}</h2>
            <p class="mt-2 text-muted leading-relaxed">{p.excerpt}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              Читати <Icon name="arrow-right" size={15} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ChecklistCta narrow />
  <LeadForm narrow />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

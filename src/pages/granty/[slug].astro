---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MobileCta from '../../components/MobileCta.astro';
import LeadForm from '../../components/LeadForm.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { grantPrograms, grantById, todayIso } from '../../data/granty';
import {
  STATUS, KIND, effectiveStatus, formatAmount, formatPeriod, formatDate,
  visibleCategories, visibleEntities, visibleRegions, visibleSectors,
} from '../../lib/granty.js';

export function getStaticPaths() {
  return grantPrograms.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const today = todayIso();
const status = effectiveStatus(p, today);
const info = STATUS[status as keyof typeof STATUS];
const amount = formatAmount(p);
const period = formatPeriod(p, today);
const replacement = p.replaced_by ? grantById(p.replaced_by) : undefined;
const cats = visibleCategories(p);
const regions = visibleRegions(p);
const sectors = visibleSectors(p);

const description = p.short.length > 300 ? p.short.slice(0, 297).trimEnd() + '…' : p.short;
const tone: Record<string, string> = {
  success: 'bg-success/10 text-success',
  accent: 'bg-accent/10 text-accent',
  muted: 'border border-border text-muted',
};

// Що входить у повну карточку. Самих даних тут немає: вони лежать у закритій базі.
const locked = [
  'надбавки до суми й ліміти по статтях витрат',
  'на що можна витрачати кошти і що заборонено',
  'вимоги до власного внеску, обов’язки й строки після отримання',
  'покроковий порядок подання та критерії оцінювання',
  'підводні камені з практики підготовки заявок',
  'посилання на першоджерела: постанови й сторінки операторів',
];
---
<Layout title={`${p.title} | Гранти ГрантПлан`} description={description} path={`/granty/${p.id}`}>
  <SiteHeader slot="header" />

  <section class="relative pt-28 md:pt-36 pb-10 md:pb-14 border-b border-border/70">
    <div class="container-site container-text">
      <a href="/granty" class="inline-flex items-center gap-2 text-muted hover:text-ink text-sm py-2 -mt-2 mb-4">← Усі програми</a>
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center rounded-full bg-accent/10 text-accent px-2.5 py-1 font-medium">{KIND[p.kind].label}</span>
        <span class={'inline-flex items-center rounded-full px-2.5 py-1 font-medium ' + tone[info.tone]}>{info.label}</span>
        <span class="text-muted">Перевірено {formatDate(p.last_checked)}</span>
      </div>
      <h1 class="mt-4 text-3xl sm:text-5xl">{p.title}</h1>
      <p class="mt-5 text-muted text-lg">{p.short}</p>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="container-site grid lg:grid-cols-[1.1fr_0.9fr] gap-8 lg:gap-10 items-start">
      <div class="grid gap-6">
        <div class="rounded-card bg-surface border border-border p-6 md:p-7">
          <h2 class="text-xl font-display font-semibold">Коротко про програму</h2>
          <dl class="mt-4 grid gap-4 text-[0.97rem]">
            {amount && (
              <div><dt class="text-sm text-muted">Сума</dt><dd class="mt-0.5 font-medium">{amount}</dd></div>
            )}
            {period && (
              <div><dt class="text-sm text-muted">Строки прийому</dt><dd class="mt-0.5">{period}</dd></div>
            )}
            {p.operator.name && (
              <div>
                <dt class="text-sm text-muted">Хто надає</dt>
                <dd class="mt-0.5">
                  {p.operator.url
                    ? <a href={p.operator.url} target="_blank" rel="noopener" class="text-accent underline underline-offset-4 inline-flex items-center gap-1.5">{p.operator.name} <Icon name="external-link" size={14} /></a>
                    : p.operator.name}
                </dd>
              </div>
            )}
            {p.entities.length > 0 && (
              <div><dt class="text-sm text-muted">Хто може подавати</dt><dd class="mt-0.5">{visibleEntities(p).join(', ')}</dd></div>
            )}
            {cats.length > 0 && (
              <div><dt class="text-sm text-muted">Для кого</dt><dd class="mt-0.5">{cats.join(', ')}</dd></div>
            )}
            {regions.length > 0 && (
              <div><dt class="text-sm text-muted">Де діє</dt><dd class="mt-0.5">{regions.join(', ')}</dd></div>
            )}
            {sectors.length > 0 && (
              <div><dt class="text-sm text-muted">Галузь</dt><dd class="mt-0.5">{sectors.join(', ')}</dd></div>
            )}
          </dl>
        </div>

        {status === 'closed' && (
          <div class="rounded-card bg-raised border border-border p-6">
            <h2 class="text-lg font-display font-semibold">Прийом заявок завершено</h2>
            <p class="mt-2 text-muted">
              {replacement
                ? <>Цю програму замінила інша: <a href={`/granty/${replacement.id}`} class="text-accent underline underline-offset-4">{replacement.title}</a>.</>
                : 'Програми такого типу зазвичай оголошують повторно. Залиште заявку, і ми повідомимо про новий набір, коли він з’явиться.'}
            </p>
          </div>
        )}

        {!p.verified && (
          <div class="rounded-card bg-raised border border-border p-6 flex gap-3">
            <Icon name="alert-triangle" size={20} class="text-accent shrink-0 mt-0.5" />
            <p class="text-muted">
              Частину умов цієї програми ми ще звіряємо з першоджерелом. Не подавайте заявку лише за цією сторінкою:
              перевірте актуальні умови в оператора програми або запитайте нас.
            </p>
          </div>
        )}
      </div>

      <aside class="rounded-card-lg bg-surface border border-border p-6 md:p-7 lg:sticky lg:top-24">
        <span class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wide text-accent">
          <Icon name="shield-check" size={15} /> Повна карточка
        </span>
        <h2 class="mt-2 text-xl font-display font-semibold">Що ще ми знаємо про цю програму</h2>
        <ul class="mt-4 grid gap-2.5 text-[0.95rem]">
          {locked.map((item) => (
            <li class="flex gap-2.5"><Icon name="check" size={17} class="text-success shrink-0 mt-0.5" /> <span>{item}</span></li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-muted leading-relaxed">
          Ми готуємо платну підписку з повними умовами й сповіщеннями про нові набори. Поки що повний розбір під вашу ситуацію робимо на безкоштовному аудиті.
        </p>
        <div class="mt-5 grid gap-3">
          <a href="#lead" class="btn btn-primary" data-analytics="click_cta_granty_card">Перевірити, чи підходить мені</a>
          <a href={site.telegram} target="_blank" rel="noopener" class="btn btn-ghost" data-analytics="click_telegram">Написати в Telegram</a>
        </div>
      </aside>
    </div>

    <div class="container-site mt-10">
      <p class="max-w-3xl text-sm text-muted leading-relaxed">
        Це довідкова інформація, а не юридична консультація й не гарантія отримання коштів. Умови програм змінюються, тому перед поданням
        звіряйте їх з офіційним джерелом. Кінцеве рішення про фінансування ухвалює оператор програми.
      </p>
    </div>
  </section>

  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

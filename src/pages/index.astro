---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import StatsBelt from '../components/StatsBelt.astro';
import Method from '../components/Method.astro';
import Pricing from '../components/Pricing.astro';
import CasesTeaser from '../components/CasesTeaser.astro';
import TeamTeaser from '../components/TeamTeaser.astro';
import ReviewsTeaser from '../components/ReviewsTeaser.astro';
import DeepDive from '../components/DeepDive.astro';
import HonestyBlock from '../components/HonestyBlock.astro';
import GrantTabs from '../components/GrantTabs.astro';
import Quiz from '../components/Quiz.astro';
import ChecklistCta from '../components/ChecklistCta.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import MobileCta from '../components/MobileCta.astro';
import { faq } from '../data/faq';

// FAQPage
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Service з прайсом
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Підготовка бізнес-плану для гранту «Власна справа»',
  provider: { '@type': 'ProfessionalService', name: 'ГрантПлан', areaServed: 'Україна' },
  areaServed: { '@type': 'Country', name: 'Україна' },
  offers: [
    { '@type': 'Offer', name: 'Аудит ідеї', price: '0', priceCurrency: 'UAH' },
    { '@type': 'Offer', name: 'Бізнес-план', priceCurrency: 'UAH', priceSpecification: { '@type': 'PriceSpecification', minPrice: '5000', maxPrice: '7000', priceCurrency: 'UAH' } },
    { '@type': 'Offer', name: '«Під ключ»', priceCurrency: 'UAH', priceSpecification: { '@type': 'PriceSpecification', minPrice: '10000', maxPrice: '12000', priceCurrency: 'UAH' } },
  ],
};
---
<Layout schema={[faqSchema, serviceSchema]}>
  <SiteHeader slot="header" />

  {/* Лендинг тримаємо коротким: спершу відповідаємо на два перші питання
       клієнта («скільки дають» і «чи підходжу я»), далі — як це працює й
       скільки коштує, і аж потім докази. Розгорнута доказова база (команда,
       експертиза, кейси, відгуки, склад послуг, розбір відмов) винесена на
       окремі сторінки: тут від неї лишились тизери й блок DeepDive, щоб
       людина дійшла до суті, не втомившись від читання. */}
  <Hero />
  <StatsBelt />
  <GrantTabs />
  <Quiz />
  <section class="container-site py-8 md:py-12" aria-labelledby="cashflow-title">
    <div class="rounded-card border border-border bg-raised p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1">
        <h2 id="cashflow-title" class="text-xl sm:text-2xl font-display font-semibold">Чи вистачить грошей до перших продажів?</h2>
        <p class="mt-2 text-muted">Порахуйте запас на шість місяців і перевірте, що станеться, якщо відкриття затримається або продажі будуть нижчими за план. Є готові приклади для кав’ярні, салону й майстерні.</p>
      </div>
      <a href="/cashflow/" class="btn btn-primary shrink-0">Відкрити калькулятор</a>
    </div>
  </section>
  <Method />
  <CasesTeaser />
  <Pricing />
  <TeamTeaser />
  <HonestyBlock />
  <ReviewsTeaser />
  <DeepDive />
  <ChecklistCta />
  <Faq />
  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

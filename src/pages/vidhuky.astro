---
// Повні відгуки клієнтів і відкриті коментарі. На головній лишився тизер
// на два відгуки — розгорнуті історії читаються тут.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import Comments from '../components/Comments.astro';
import LeadForm from '../components/LeadForm.astro';
---
<Layout
  title="Відгуки клієнтів про підготовку бізнес-плану | ГрантПлан"
  description="Розгорнуті історії клієнтів: що знайшли на безкоштовному аудиті, як рахували кошторис і фінмодель, як минула співбесіда та що було після рішення комісії."
  path="/vidhuky"
>
  <SiteHeader slot="header" />

  <section class="pt-28 md:pt-36 pb-10 md:pb-14 border-b border-border/70">
    <div class="container-site max-w-3xl">
      <a href="/" class="flex w-fit items-center gap-2 text-muted hover:text-ink text-sm mb-6">← На головну</a>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
        <Icon name="quote" size={14} class="text-accent" /> Досвід клієнтів
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl">Відгуки клієнтів</h1>
      <p class="mt-5 text-muted text-lg leading-relaxed">
        Не «дякую, все супер», а розбір по етапах: що знайшли на аудиті, як рахували кошторис і фінмодель, як минула співбесіда і що було після рішення. Є й відгук на чотири зірки — ми його не ховаємо.
      </p>
    </div>
  </section>

  <Reviews />
  <Comments />
  <LeadForm />

  <SiteFooter slot="footer" />
  <MobileCta />
</Layout>

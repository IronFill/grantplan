---
import '../styles/global.css';
import { site } from '../data/site';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  /** відносний шлях сторінки, напр. "/case-bpla" */
  path?: string;
  ogImage?: string;
  /** додаткові JSON-LD об'єкти */
  schema?: unknown[];
  noindex?: boolean;
}

const {
  title = 'Бізнес-план під грант «Власна справа» до 500 000 ₴ | ГрантПлан',
  description = 'Юрист готує бізнес-план під грант за 2–3 дні. Чесна оцінка шансів до оплати, ринкові ціни в кошторисі, 2 раунди правок. Харків.',
  path = '/',
  ogImage = '/og-default.png',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageAbs = new URL(ogImage, site.url).href;
const year = new Date().getFullYear();

// Базова розмітка ProfessionalService — присутня на всіх сторінках
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ГрантПлан',
  description:
    'Підготовка бізнес-планів під державний грант «Власна справа» за формою Дії.',
  url: site.url,
  telephone: site.phone,
  areaServed: { '@type': 'Country', name: 'Україна' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Харків',
    addressRegion: 'Харківська область',
    addressCountry: 'UA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 49.9935, longitude: 36.2304 },
  priceRange: '₴₴',
};

const allSchema = [baseSchema, ...schema];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#14181C" />
    <meta name="color-scheme" content="dark light" />

    <!-- Тема (світла/темна): застосовуємо збережений вибір ДО першого
         пофарбування, щоб уникнути "спалаху" не тієї теми. За замовчуванням —
         темна (фірмовий стиль); світла — лише за явним вибором користувача. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#F0E6D3' : '#14181C');
        } catch (e) {}
      })();
    </script>

    <!-- Favicon (оранжевий квадрат зі скругленням + галочка-графік) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ГрантПлан" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Аналітика Plausible (без cookies, працює завжди) -->
    <script
      is:inline
      defer
      data-domain="grantplan.com.ua"
      src="https://plausible.io/js/script.tagged-events.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
    </script>

    <!-- GA4 / Meta Pixel: вантажаться лише якщо задані PUBLIC_GA4_ID /
         PUBLIC_META_PIXEL_ID і користувач уже погодився на cookies раніше
         (див. src/lib/analytics.ts і CookieConsent.astro). -->
    <script>
      import { initAnalyticsFromStoredConsent } from '../lib/analytics';
      initAnalyticsFromStoredConsent();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(allSchema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти до змісту</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent />

    <!-- Глобальний fade-up при скролі (IntersectionObserver, один раз) -->
    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const supported = 'IntersectionObserver' in window;
      const items = document.querySelectorAll<HTMLElement>('.reveal');

      if (!prefersReduced && supported) {
        // Ховаємо контент тільки тепер, коли анімація гарантовано працюватиме.
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        items.forEach((el) => io.observe(el));

        // Підстраховка: усе, що вже у вʼюпорті на старті — показати одразу.
        requestAnimationFrame(() => {
          items.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('is-visible');
          });
        });
      }
      // Якщо reduced-motion або немає IO — клас .js-reveal не додається,
      // тож .reveal лишаються повністю видимими (див. global.css).
    </script>

    <!-- Делеговане відстеження [data-analytics] по всій сторінці — єдине
         місце замість дублювання в кожному компоненті з такою кнопкою. -->
    <script>
      import { trackEvent } from '../lib/analytics';
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest<HTMLElement>('[data-analytics]');
        const ev = el?.getAttribute('data-analytics');
        if (ev) trackEvent(ev);
      });
    </script>
    <!-- рік для футера, якщо потрібен через JS -->
    <span hidden data-year={year}></span>
  </body>
</html>

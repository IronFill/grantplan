# --- Telegram Bot (обробка форм через Netlify Function) ---
# Токен бота від @BotFather
TG_BOT_TOKEN=

# ID чату / каналу, куди надсилати заявки (можна отримати через @userinfobot)
TG_CHAT_ID=

# --- Базовий URL сайту (для sitemap / canonical) ---
SITE_URL=https://grantplan.com.ua

# --- Аналітика/реклама (опційно, вантажаться лише після згоди на cookies) ---
# GA4 Measurement ID, напр. G-XXXXXXX. Порожньо = GA4 не підключено.
PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID. Порожньо = Pixel не підключено.
PUBLIC_META_PIXEL_ID=
